<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.huiping.server.mapper.ProductDetailMapper">

  <select id="findDetail" resultType="org.huiping.server.entity.ProductDetail">
    SELECT * FROM product_details WHERE product_id=#{productId} LIMIT 1
  </select>

</mapper>
