# 复制为 .env 后填写（.env 已加入 .gitignore）
# 小程序 AppID（须与 miniprogram/project.config.json 里 appid 一致）
WX_MINI_APPID=wx3f0567dc86f7ca12
# 小程序 AppSecret（微信公众平台 → 开发 → 开发设置 → 生成/查看）不填则登录接口返回 500
WX_MINI_SECRET=your_app_secret_here

# 登录 JWT，请使用足够长的随机串（勿泄露、勿提交）
JWT_SECRET=wx71269755a3711ceb
JWT_EXPIRES_IN=30d

# MySQL（本机开发默认 127.0.0.1 / hpt；连远程时改 DB_HOST 等）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hpt
