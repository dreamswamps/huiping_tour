# 复制为 .env 后填写（.env 已加入 .gitignore）
# 小程序 AppID（须与 miniprogram/project.config.json 里 appid 一致）
WX_MINI_APPID=wx3f0567dc86f7ca12
# 小程序 AppSecret（微信公众平台 → 开发 → 开发设置 → 生成/查看）不填则登录接口返回 500
WX_MINI_SECRET=your_app_secret_here

# 登录 JWT，请使用足够长的随机串（勿泄露、勿提交）
JWT_SECRET=wx71269755a3711ceb
JWT_EXPIRES_IN=30d

# MySQL（本机开发默认 127.0.0.1 / hpt；连远程时改 DB_HOST 等）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hpt

# 发货：true 为默认 Mock；false 时调用真实下单接口
MOCK_DELIVERY=true
# 菜鸟开放平台接口和阿里系应用鉴权参数
CAINIAO_URL=
CAINIAO_APP_KEY=
CAINIAO_APP_SECRET=
CAINIAO_SELLER_ID=TEST_SELLER_ID
# 无真实 AppKey 时可设为 true，仅用于前端联调，不调用菜鸟接口
CAINIAO_SANDBOX=false
# 发件人信息；收件人信息从订单地址读取
CAINIAO_SENDER_NAME=红旅薪传
CAINIAO_SENDER_PHONE=
CAINIAO_SENDER_PROVINCE=
CAINIAO_SENDER_CITY=
CAINIAO_SENDER_DISTRICT=
CAINIAO_SENDER_ADDRESS=
# 包裹重量，单位：克
CAINIAO_DEFAULT_WEIGHT=1000
