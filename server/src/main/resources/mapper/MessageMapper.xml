<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.huiping.server.mapper.MessageMapper">
    <select id="selectLatest" resultType="org.huiping.server.entity.Message">
        SELECT *
        FROM messages
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <select id="selectById" resultType="org.huiping.server.entity.Message">
        SELECT *
        FROM messages
        WHERE id=#{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO messages(user_id,content)
        VALUES(#{userId},#{content})
    </insert>
</mapper>
