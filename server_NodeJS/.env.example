# 复制为 .env 后填写（.env 已加入 .gitignore）
# 小程序 AppID（须与 miniprogram/project.config.json 里 appid 一致）
WX_MINI_APPID=wx3f0567dc86f7ca12
# 小程序 AppSecret（微信公众平台 → 开发 → 开发设置 → 生成/查看）不填则登录接口返回 500
WX_MINI_SECRET=your_app_secret_here

# 登录 JWT，请使用足够长的随机串（勿泄露、勿提交）
JWT_SECRET=jwt_secret_here
JWT_EXPIRES_IN=30d

# MySQL（本机开发默认 127.0.0.1 / hpt；连远程时改 DB_HOST 等）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hpt

# 发货：true 为默认 Mock；false 时调用真实下单接口
MOCK_DELIVERY=true
# 顺丰开放平台（对应 yml 中 delivery.sf-* 配置）
# 生产地址：https://sfapi.sf-express.com/std/service
# 沙箱地址：https://sfapi-sbox.sf-express.com/std/service
SF_URL=https://sfapi.sf-express.com/std/service
# 顺丰丰桥「顾客编码 / 合作伙伴 ID」
SF_PARTNER_ID=
# 顺丰丰桥「校验码」，用于签名（MD5 + Base64）
SF_CHECKWORD=
# 服务码，默认下订单接口；查路由/取消订单时可改
SF_SERVICE_NAME=EXP_RECE_CREATE_ORDER
# 发件人信息；收件人信息从订单地址读取
SF_SENDER_NAME=红旅薪传
SF_SENDER_PHONE=
SF_SENDER_PROVINCE=
SF_SENDER_CITY=
SF_SENDER_DISTRICT=
SF_SENDER_ADDRESS=
# 包裹重量，单位：克
SF_DEFAULT_WEIGHT=1000
