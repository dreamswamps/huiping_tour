<view class="page">

  <!-- 顶部背景图 -->
  <image class="top-bg" src="https://free.picui.cn/free/2026/05/16/6a086d2f2293a.png" mode="widthFix"></image>

  <!-- 返回首页按钮 -->
  <view class="back-home-btn" bindtap="onBackHome">
    <image class="home-icon" src="{{svgsUrl}}/svgs/svgs/station5-btn-home.svg" mode="aspectFit"></image>
    <text>返回首页</text>
  </view>

  <!-- 圆角内容容器 -->
  <view class="content-panel">

    <!-- 站点信息 -->
    <view class="station-info">
      <view class="station-num-wrap">
        <text class="num-line"></text>
        <text class="station-num">{{stationNum}}</text>
        <text class="num-line"></text>
      </view>
      <text class="station-title">{{stationTitle}}</text>
      <text class="station-name">{{stationName}}</text>
      <text class="station-desc">{{stationDesc}}</text>
    </view>

    <!-- 发布传薪宣言卡片 -->
    <view class="declaration-card">
      <view class="decl-header">
        <text class="decl-icon">📣</text>
        <text class="decl-title">发布传薪宣言</text>
      </view>

      <view class="decl-input-wrap">
        <textarea
          class="decl-input"
          placeholder="写下你的传薪宣言，分享给所有传薪者…"
          maxlength="{{maxLen}}"
          value="{{declarationText}}"
          bindinput="onInputDecl"
        ></textarea>

        <view class="input-footer">
          <text class="char-count">{{declarationText.length}}/{{maxLen}}字</text>
          <text class="pub-status">{{declarationText.length > 0 ? '可发布' : '尚未发布'}}</text>
        </view>

        <view class="publish-btn {{declarationText.length > 0 ? 'active' : ''}}" bindtap="onPublish">
          <image wx:if="{{declarationText.length > 0}}" class="pub-btn-icon" src="{{svgsUrl}}/svgs/svgs/station5-publish-icon.svg" mode="aspectFit"></image>
          <text>发布传薪宣言</text>
        </view>
      </view>
    </view>

    <!-- 传薪宣言墙·实时滚动 -->
    
    <!-- 收听广播剧卡片 -->
    <view class="radio-card {{isPlaying ? 'playing' : ''}}" bindtap="onPlayRadio">
      <view class="radio-left">
        <view class="radio-icon-wrap">
          <image class="radio-main-icon" src="{{svgsUrl}}/svgs/svgs/station1-card-radio.svg" mode="aspectFit"></image>
          <image class="radio-sub-icon" src="{{svgsUrl}}/svgs/svgs/station1-card-radiolabel.svg" mode="aspectFit"></image>
        </view>
        <view class="radio-text-wrap">
          <text class="radio-title">收听广播剧</text>
          <text class="radio-sub">《薪火延续》· 革命故事</text>
        </view>
      </view>
      <image class="play-icon" src="{{isPlaying ? svgsUrl + '/svgs/svgs/station1-pause.svg' : svgsUrl + '/svgs/svgs/station1-play-arrow.svg'}}" mode="aspectFit"></image>
    </view>
<view class="wall-card">
      <view class="wall-header">
        <text class="wall-icon">📜</text>
        <text class="wall-title">传薪宣言墙·实时滚动</text>
      </view>

      <view class="wall-viewport">
        <view wx:if="{{wallLoading}}" class="wall-state">
          <text>加载中…</text>
        </view>
        <view wx:elif="{{wallEmpty}}" class="wall-state">
          <text>暂无传薪宣言，快来发布第一条吧</text>
        </view>
        <view wx:else class="wall-scroll-wrap">
          <view
            class="wall-scroll-inner {{wallScrollEnabled ? 'wall-scroll-animate' : ''}}"
            style="{{wallScrollEnabled ? 'animation-duration: ' + scrollDuration + 's;' : ''}}"
          >
            <view class="wall-list">
              <view class="wall-item" wx:for="{{scrollPrimary}}" wx:key="loopKey">
                <text class="wall-content">{{item.content}}</text>
                <text class="wall-time">{{item.time}}</text>
              </view>
            </view>
            <view class="wall-list" wx:if="{{wallScrollEnabled}}">
              <view class="wall-item" wx:for="{{scrollSecondary}}" wx:key="loopKey">
                <text class="wall-content">{{item.content}}</text>
                <text class="wall-time">{{item.time}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 打卡按钮 -->
    <view class="checkin-btn {{isCheckedIn ? 'checked' : ''}}" bindtap="onCheckIn">
      <view class="checkin-icon-wrap">
        <image class="checkin-icon" src="{{svgsUrl}}/svgs/svgs/checkin-icon.svg" mode="aspectFit"></image>
        <image wx:if="{{isCheckedIn}}" class="checkin-checked-icon" src="{{svgsUrl}}/svgs/svgs/checkin-checked.svg" mode="aspectFit"></image>
      </view>
      <text>{{isCheckedIn ? '已打卡' : '打卡'}}</text>
    </view>

    <!-- 去这里导航按钮 -->
    <view class="nav-btn" bindtap="onNavigate">
      <text>去这里</text>
    </view>

    <!-- 返回地图 -->
    <view class="back-map-btn" bindtap="onBackToMap">
      <text>返回地图</text>
    </view>

  </view>

</view>
