<view class="page">

  <!-- 顶部背景图 -->
  <image class="top-bg" src="https://free.picui.cn/free/2026/05/16/6a086d2c3c033.jpg" mode="widthFix"></image>

  <!-- 返回首页按钮 -->
  <view class="back-home-btn" bindtap="onBackHome">
    <image class="home-icon" src="{{baseUrl}}/img/station2-home-icon.svg" mode="aspectFit"></image>
    <text>返回首页</text>
  </view>

  <!-- 圆角内容面板 -->
  <view class="content-panel">

    <!-- 站点信息 -->
    <view class="station-info">
      <view class="station-num-wrap">
        <text class="num-line"></text>
        <text class="station-num">{{stationNum}}</text>
        <text class="num-line"></text>
      </view>
      <text class="station-title">{{stationTitle}}</text>
      <text class="station-name">{{stationName}}</text>
      <text class="station-desc">{{stationDesc}}</text>
    </view>

    <!-- AR扫描卡片 -->
    <view class="ar-card">
      <view class="ar-header">
        <text class="ar-icon">✨</text>
        <view class="ar-title-wrap">
          <text class="ar-title">解锁历史故事</text>
          <text class="ar-sub">AR扫描体验·互动收集</text>
        </view>
      </view>
      <text class="ar-desc">用手机扫描现场指定AR标识，收集历史物品，观看人物动画，完成第二站打卡。</text>
      <view class="ar-btn" bindtap="onArScan">
        <image class="ar-btn-icon" src="{{baseUrl}}/img/station2-ar-btn-icon.svg" mode="aspectFit"></image>
        <text>采集红色榧子·AR扫描</text>
      </view>
    </view>

    <!-- 观看人物动画卡片 -->
    <view class="red-card" bindtap="onAnimationPlay">
      <view class="red-left">
        <view class="red-icon-wrap">
          <image class="red-main-icon" src="{{baseUrl}}/img/station2-redcard-main.svg" mode="aspectFit"></image>
          <image class="red-sub-icon" src="{{baseUrl}}/img/station2-redcard-sub.svg" mode="aspectFit"></image>
        </view>
        <view class="red-text-wrap">
          <text class="red-title">观看人物动画</text>
          <text class="red-sub">《雪妹与雪泉》· 革命故事</text>
        </view>
      </view>
      <image class="play-icon" src="{{baseUrl}}/img/station2-play-arrow.svg" mode="aspectFit"></image>
    </view>

    <!-- 打卡按钮 -->
    <view class="checkin-btn {{isCheckedIn ? 'checked' : ''}}" bindtap="onCheckIn">
      <view class="checkin-icon-wrap">
        <image class="checkin-icon" src="{{baseUrl}}/img/checkin-icon.svg" mode="aspectFit"></image>
        <image wx:if="{{isCheckedIn}}" class="checkin-checked-icon" src="{{baseUrl}}/img/checkin-checked.svg" mode="aspectFit"></image>
      </view>
      <text>{{isCheckedIn ? '已打卡' : '打卡'}}</text>
    </view>

    <!-- 去这里导航按钮 -->
    <view class="nav-btn" bindtap="onNavigate">
      <text>去这里</text>
    </view>

    <!-- 返回地图 -->
    <view class="back-map-btn" bindtap="onBackToMap">
      <text>返回地图</text>
    </view>

  </view>

</view>
