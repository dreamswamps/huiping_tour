<view class="page">

  <!-- 顶部背景图 -->
  <image class="top-bg" src="https://svgs1.oss-cn-beijing.aliyuncs.com/station2.jpg" mode="widthFix"></image>

  <!-- 返回首页按钮 -->
  <view class="back-home-btn" bindtap="onBackHome">
    <image class="home-icon" src="{{svgsUrl}}/svgs/svgs/station2-home-icon.svg" mode="aspectFit"></image>
    <text>返回首页</text>
  </view>

  <!-- 圆角内容面板 -->
  <view class="content-panel">

    <!-- 站点信息 -->
    <view class="station-info">
      <view class="station-num-wrap">
        <text class="num-line"></text>
        <text class="station-num">{{stationNum}}</text>
        <text class="num-line"></text>
      </view>
      <text class="station-title">{{stationTitle}}</text>
      <text class="station-name">{{stationName}}</text>
      <text class="station-desc">{{stationDesc}}</text>
    </view>

    <!-- AR扫描卡片 -->
    <view class="ar-card">
      <view class="ar-header">
        <text class="ar-icon">✨</text>
        <view class="ar-title-wrap">
          <text class="ar-title">解锁历史故事</text>
          <text class="ar-sub">AR扫描体验·互动收集</text>
        </view>
      </view>
      <text class="ar-desc">用手机扫描现场指定AR标识，收集历史物品，观看人物动画，完成第二站打卡。</text>
      <view class="ar-btn" bindtap="onArScan">
        <image class="ar-btn-icon" src="{{svgsUrl}}/svgs/svgs/station2-ar-btn-icon.svg" mode="aspectFit"></image>
        <text>采集红色榧子·AR扫描</text>
      </view>
    </view>

    <!-- 观看人物动画卡片 -->
    <!-- 收听广播剧卡片 -->
    <view class="radio-card {{isPlaying ? 'playing' : ''}}" bindtap="onPlayRadio">
      <view class="radio-left">
        <view class="radio-icon-wrap">
          <image class="radio-main-icon" src="{{svgsUrl}}/svgs/svgs/station1-card-radio.svg" mode="aspectFit"></image>
          <image class="radio-sub-icon" src="{{svgsUrl}}/svgs/svgs/station1-card-radiolabel.svg" mode="aspectFit"></image>
        </view>
        <view class="radio-text-wrap">
          <text class="radio-title">收听广播剧</text>
          <text class="radio-sub">《雪妹与雪泉》· 革命故事</text>
        </view>
      </view>
      <image class="play-icon" src="{{isPlaying ? svgsUrl + '/svgs/svgs/station1-pause.svg' : svgsUrl + '/svgs/svgs/station2-play-arrow.svg'}}" mode="aspectFit"></image>
    </view>


    <!-- 观看历史视频 -->
    <view class="video-card" bindtap="onPlayVideo">
      <view class="video-left">
        <view class="video-icon-wrap">
          <image class="video-play-icon" src="{{svgsUrl}}/svgs/svgs/station2-play-arrow.svg" mode="aspectFit"></image>
        </view>
        <view class="video-text-wrap">
          <text class="video-title">观看动画--《雪妹的红豆杉》</text>
          <text class="video-sub">《雪妹的红豆杉》</text>
        </view>
      </view>
      <view class="video-arrow">
        <image class="video-arrow-icon" src="{{svgsUrl}}/svgs/svgs/station2-play-arrow.svg" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 打卡按钮 -->
    <view class="checkin-btn {{isCheckedIn ? 'checked' : ''}}" bindtap="onCheckIn">
      <text>{{isCheckedIn ? '已打卡' : '打卡'}}</text>
    </view>

    <!-- 去这里导航按钮 -->
    <view class="nav-btn" bindtap="onNavigate">
      <text>去这里</text>
    </view>

    <!-- 返回地图 -->
    <view class="back-map-btn" bindtap="onBackToMap">
      <text>返回地图</text>
    </view>

  </view>

</view>
