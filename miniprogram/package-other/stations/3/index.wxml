<view class="page">

  <!-- 顶部背景图 -->
  <image class="top-bg" src="https://free.picui.cn/free/2026/05/16/6a086d2d3d98f.png" mode="widthFix"></image>

  <!-- 返回首页按钮 -->
  <view class="back-home-btn" bindtap="onBackHome">
    <image class="home-icon" src="{{baseUrl}}/img/station3-btn-home.svg" mode="aspectFit"></image>
    <text>返回首页</text>
  </view>

  <!-- 圆角内容容器 -->
  <view class="content-panel">

    <!-- 站点信息 -->
    <view class="station-info">
      <view class="station-num-wrap">
        <text class="num-line"></text>
        <text class="station-num">{{stationNum}}</text>
        <text class="num-line"></text>
      </view>
      <text class="station-title">{{stationTitle}}</text>
      <text class="station-name">{{stationName}}</text>
      <text class="station-desc">{{stationDesc}}</text>
    </view>

    <!-- 获得历史物品 AR卡片 -->
    <view class="ar-card">
      <view class="ar-header">
        <text class="ar-icon">✨</text>
        <view class="ar-title-wrap">
          <text class="ar-title">获得历史物品</text>
          <text class="ar-sub">AR扫描体验·互动收集</text>
        </view>
      </view>
      <text class="ar-desc">用手机扫描现场指定AR标识，收集传薪物品，完成第三站打卡。</text>
      <view class="ar-btn" bindtap="onArScan">
        <image class="ar-btn-icon" src="{{baseUrl}}/img/station3-ar-scanicon.svg" mode="aspectFit"></image>
        <text>采集煤油灯·AR扫描</text>
      </view>
    </view>

    <!-- 守护承诺书卡片 -->
    <view class="pledge-card">
      <!-- 标题区 -->
      <view class="pledge-header">
        <text class="pledge-emoji">📜</text>
        <view class="pledge-title-wrap">
          <text class="pledge-title">守护承诺书</text>
          <text class="pledge-sub">签署你的传薪承诺</text>
        </view>
      </view>

      <!-- 承诺内容展示区 -->
      <view class="pledge-body">
        <text class="pledge-label">守护传薪承诺书</text>
        <text class="pledge-line1">我，作为传薪之旅的亲历者，郑重承诺：</text>
        <text class="pledge-line2">铭记历史，传承红色基因；</text>
        <text class="pledge-line3">守护精神，续写时代篇章；</text>
        <text class="pledge-line4">将这薪火，代代相传。</text>
      </view>

      <!-- 署名提示 -->
      <view class="pledge-hint {{hasSigned ? 'signed' : ''}}">
        <text>{{hasSigned ? '✅ 已完成署名 · 感谢您的守护' : '点击"签署承诺书"填写您的署名'}}</text>
      </view>

      <!-- 签署按钮 -->
      <view class="pledge-btn {{hasSigned ? 'signed' : ''}}" bindtap="onSignPledge">
        <image class="pledge-sign-icon" src="{{baseUrl}}/img/station3-promise-sign.svg" mode="aspectFit"></image>
        <text>{{hasSigned ? '已完成签署' : '签署守护承诺书'}}</text>
      </view>

    </view>

    <!-- 打卡按钮 -->
    <view class="checkin-btn {{isCheckedIn ? 'checked' : ''}}" bindtap="onCheckIn">
      <view class="checkin-icon-wrap">
        <image class="checkin-icon" src="{{baseUrl}}/img/checkin-icon.svg" mode="aspectFit"></image>
        <image wx:if="{{isCheckedIn}}" class="checkin-checked-icon" src="{{baseUrl}}/img/checkin-checked.svg" mode="aspectFit"></image>
      </view>
      <text>{{isCheckedIn ? '已打卡' : '打卡'}}</text>
    </view>

    <!-- 去这里导航按钮 -->
    <view class="nav-btn" bindtap="onNavigate">
      <text>去这里</text>
    </view>

    <!-- 返回地图 -->
    <view class="back-map-btn" bindtap="onBackToMap">
      <text>返回地图</text>
    </view>

  </view>

</view>
