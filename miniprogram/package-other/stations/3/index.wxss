/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #f8f5f0;
  position: relative;
}

/* ==================== 顶部背景 ==================== */
.top-bg {
  width: 100%;
  height: auto;
  display: block;
}

/* ==================== 返回首页按钮（fixed） ==================== */
.back-home-btn {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 80rpx);
  left: 34rpx;
  width: 224rpx;
  height: 84rpx;
  padding: 0 8rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 0 5rpx rgba(88, 5, 5, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
}
.home-icon {
  width: 30rpx;
  height: 30rpx;
}
.back-home-btn text {
  font-size: 24rpx;
  color: #c91f37;
}

/* ==================== 圆角内容面板 ==================== */
.content-panel {
  margin-top: -40rpx;
  background: #f8f5f0;
  border-top-left-radius: 80rpx;
  border-top-right-radius: 80rpx;
  padding: 60rpx 56rpx 80rpx;
  position: relative;
  z-index: 1;
}

/* ==================== 站点信息 ==================== */
.station-info {
  text-align: center;
  margin-bottom: 40rpx;
}
.station-num-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.num-line {
  width: 112rpx;
  height: 2rpx;
  background: #d4a017;
}
.station-num {
  font-size: 28rpx;
  color: #d4a017;
  letter-spacing: 4rpx;
  margin: 0 16rpx;
  font-family: "Noto Sans SC", sans-serif;
}
.station-title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #d4a017;
  letter-spacing: 5rpx;
  font-family: "Noto Sans SC", sans-serif;
}
.station-name {
  display: block;
  font-size: 32rpx;
  color: #c8a87a;
  margin-top: 14rpx;
  font-family: "Noto Sans SC", sans-serif;
}
.station-desc {
  display: block;
  font-size: 28rpx;
  color: #c8a87a;
  line-height: 1.6;
  margin-top: 24rpx;
  padding: 0 10rpx;
  font-family: "Noto Sans SC", sans-serif;
}

/* ==================== AR卡片（获得历史物品） ==================== */
.ar-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  padding: 30rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
.ar-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.ar-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.ar-title-wrap {
  display: flex;
  flex-direction: column;
}
.ar-title {
  font-size: 28rpx;
  color: #c91f37;
  font-weight: 700;
}
.ar-sub {
  font-size: 24rpx;
  color: #5c3a21;
  margin-top: 4rpx;
}
.ar-desc {
  display: block;
  font-size: 24rpx;
  color: #5c3a21;
  line-height: 1.6;
  margin-bottom: 22rpx;
}
.ar-btn {
  width: 100%;
  height: 76rpx;
  background: linear-gradient(274deg, #ce3b45 3%, #e4b983 46%, #cd3542 76%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ar-btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.ar-btn text {
  font-size: 28rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 守护承诺书卡片 ==================== */
.pledge-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  padding: 30rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
.pledge-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.pledge-emoji {
  font-size: 40rpx;
  margin-right: 12rpx;
}
.pledge-title-wrap {
  display: flex;
  flex-direction: column;
}
.pledge-title {
  font-size: 28rpx;
  color: #c91f37;
  font-weight: 700;
}
.pledge-sub {
  font-size: 24rpx;
  color: #5c3a21;
  margin-top: 4rpx;
}

/* 承诺正文区域 */
.pledge-body {
  background: #f8f5f0;
  border-radius: 40rpx;
  border: 2rpx solid #f2dcce;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}
.pledge-label {
  display: block;
  font-size: 24rpx;
  color: #c91f37;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.pledge-line1,
.pledge-line2,
.pledge-line3,
.pledge-line4 {
  display: block;
  font-size: 24rpx;
  color: #5c3a21;
  line-height: 1.7;
}

/* 署名提示条 */
.pledge-hint {
  background: #f8f5f0;
  border-radius: 40rpx;
  border: 2rpx solid #f2dcce;
  height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.pledge-hint.signed {
  border-color: #d4a017;
  background: #fff9e6;
}
.pledge-hint text {
  font-size: 24rpx;
  color: #bdbdbd;
}
.pledge-hint.signed text {
  color: #5c3a21;
  font-weight: 500;
}

/* 签署按钮 */
.pledge-btn {
  width: 100%;
  height: 114rpx;
  background: linear-gradient(323deg, #e3b17f 0%, #cc3140 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pledge-btn.signed {
  background: linear-gradient(323deg, #c8a87a 0%, #a88a68 100%);
}
.pledge-sign-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.pledge-btn text {
  font-size: 30rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 打卡按钮 ==================== */
.checkin-btn {
  width: 636rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #d4a017, #f5d78e);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(212, 160, 23, 0.3);
}
.checkin-btn.checked {
  background: linear-gradient(135deg, #4caf50, #81c784);
  box-shadow: 0 8rpx 20rpx rgba(76, 175, 80, 0.3);
}
.checkin-btn text {
  font-size: 32rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 去这里导航按钮 ==================== */
.nav-btn {
  width: 636rpx;
  height: 88rpx;
  background: linear-gradient(274deg, #ce3b45 3%, #e4b983 46%, #cd3542 76%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
}
.nav-btn text {
  font-size: 32rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 返回地图 ==================== */
.back-map-btn {
  width: 100%;
  height: 88rpx;
  background: #f3e1d6;
  border-radius: 40rpx;
  border: 1rpx solid rgba(168, 1, 1, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-map-btn text {
  font-size: 32rpx;
  color: #c91f37;
}

/* Radio card styles */
.radio-card {
  width: 100%;
  height: 184rpx;
  background: #a80101;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
.radio-left {
  display: flex;
  align-items: center;
}
.radio-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  position: relative;
  flex-shrink: 0;
}
.radio-main-icon {
  width: 56rpx;
  height: 56rpx;
}
.radio-sub-icon {
  width: 54rpx;
  height: 54rpx;
  position: absolute;
  left: 6rpx;
  top: 6rpx;
}
.radio-text-wrap {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}
.radio-title {
  font-size: 30rpx;
  color: #f5e6c8;
  font-weight: 700;
  font-family: "Noto Sans SC", sans-serif;
}
.radio-sub {
  font-size: 22rpx;
  color: #c8a87a;
  margin-top: 8rpx;
  font-family: "Noto Sans SC", sans-serif;
}
.play-icon {
  width: 44rpx;
  height: 44rpx;
}

/* Playing state animation */
.radio-card.playing {
  box-shadow:
    0 0 24rpx 8rpx rgba(168, 1, 1, 0.4),
    0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  animation: radioPulse 1.5s ease-in-out infinite;
}

@keyframes radioPulse {
  0%,
  100% {
    box-shadow:
      0 0 20rpx 6rpx rgba(168, 1, 1, 0.3),
      0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  }
  50% {
    box-shadow:
      0 0 36rpx 12rpx rgba(168, 1, 1, 0.6),
      0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  }
}
