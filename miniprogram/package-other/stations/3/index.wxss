/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #F8F5F0;
  position: relative;
}

/* ==================== 顶部背景 ==================== */
.top-bg {
  width: 100%;
  height: auto;
  display: block;
}

/* ==================== 返回首页按钮（fixed） ==================== */
.back-home-btn {
  position: fixed;
  top: 44rpx;
  left: 34rpx;
  width: 192rpx;
  height: 68rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 0 5rpx rgba(88, 5, 5, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.home-icon {
  width: 30rpx;
  height: 30rpx;
}
.back-home-btn text {
  font-size: 24rpx;
  color: #C91F37;
}

/* ==================== 圆角内容面板 ==================== */
.content-panel {
  margin-top: -40rpx;
  background: #F8F5F0;
  border-top-left-radius: 80rpx;
  border-top-right-radius: 80rpx;
  padding: 60rpx 56rpx 80rpx;
  position: relative;
  z-index: 1;
}

/* ==================== 站点信息 ==================== */
.station-info {
  text-align: center;
  margin-bottom: 40rpx;
}
.station-num-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.num-line {
  width: 112rpx;
  height: 2rpx;
  background: #D4A017;
}
.station-num {
  font-size: 28rpx;
  color: #D4A017;
  letter-spacing: 4rpx;
  margin: 0 16rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #D4A017;
  letter-spacing: 5rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-name {
  display: block;
  font-size: 32rpx;
  color: #C8A87A;
  margin-top: 14rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-desc {
  display: block;
  font-size: 28rpx;
  color: #C8A87A;
  line-height: 1.6;
  margin-top: 24rpx;
  padding: 0 10rpx;
  font-family: 'Noto Sans SC', sans-serif;
}

/* ==================== AR卡片（获得历史物品） ==================== */
.ar-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  padding: 30rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
.ar-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.ar-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.ar-title-wrap {
  display: flex;
  flex-direction: column;
}
.ar-title {
  font-size: 28rpx;
  color: #C91F37;
  font-weight: 700;
}
.ar-sub {
  font-size: 24rpx;
  color: #5C3A21;
  margin-top: 4rpx;
}
.ar-desc {
  display: block;
  font-size: 24rpx;
  color: #5C3A21;
  line-height: 1.6;
  margin-bottom: 22rpx;
}
.ar-btn {
  width: 100%;
  height: 76rpx;
  background: linear-gradient(274deg, #CE3B45 3%, #E4B983 46%, #CD3542 76%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ar-btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.ar-btn text {
  font-size: 28rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 守护承诺书卡片 ==================== */
.pledge-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  padding: 30rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
.pledge-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.pledge-emoji {
  font-size: 40rpx;
  margin-right: 12rpx;
}
.pledge-title-wrap {
  display: flex;
  flex-direction: column;
}
.pledge-title {
  font-size: 28rpx;
  color: #C91F37;
  font-weight: 700;
}
.pledge-sub {
  font-size: 24rpx;
  color: #5C3A21;
  margin-top: 4rpx;
}

/* 承诺正文区域 */
.pledge-body {
  background: #F8F5F0;
  border-radius: 40rpx;
  border: 2rpx solid #F2DCCE;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}
.pledge-label {
  display: block;
  font-size: 24rpx;
  color: #C91F37;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.pledge-line1,
.pledge-line2,
.pledge-line3,
.pledge-line4 {
  display: block;
  font-size: 24rpx;
  color: #5C3A21;
  line-height: 1.7;
}

/* 署名提示条 */
.pledge-hint {
  background: #F8F5F0;
  border-radius: 40rpx;
  border: 2rpx solid #F2DCCE;
  height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.pledge-hint.signed {
  border-color: #D4A017;
  background: #FFF9E6;
}
.pledge-hint text {
  font-size: 24rpx;
  color: #BDBDBD;
}
.pledge-hint.signed text {
  color: #5C3A21;
  font-weight: 500;
}

/* 签署按钮 */
.pledge-btn {
  width: 100%;
  height: 114rpx;
  background: linear-gradient(323deg, #E3B17F 0%, #CC3140 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pledge-btn.signed {
  background: linear-gradient(323deg, #C8A87A 0%, #A88A68 100%);
}
.pledge-sign-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.pledge-btn text {
  font-size: 30rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 打卡按钮 ==================== */
.checkin-btn {
  width: 636rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #D4A017, #F5D78E);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(212, 160, 23, 0.3);
}
.checkin-btn.checked {
  background: linear-gradient(135deg, #4CAF50, #81C784);
  box-shadow: 0 8rpx 20rpx rgba(76, 175, 80, 0.3);
}
.checkin-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  margin-right: 12rpx;
}
.checkin-icon {
  width: 44rpx;
  height: 44rpx;
}
.checkin-checked-icon {
  width: 24rpx;
  height: 24rpx;
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
}
.checkin-btn text {
  font-size: 32rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 去这里导航按钮 ==================== */
.nav-btn {
  width: 636rpx;
  height: 88rpx;
  background: linear-gradient(274deg, #CE3B45 3%, #E4B983 46%, #CD3542 76%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
}
.nav-btn text {
  font-size: 32rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 返回地图 ==================== */
.back-map-btn {
  width: 100%;
  height: 88rpx;
  background: #F3E1D6;
  border-radius: 40rpx;
  border: 1rpx solid rgba(168, 1, 1, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-map-btn text {
  font-size: 32rpx;
  color: #C91F37;
}
