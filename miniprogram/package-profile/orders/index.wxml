<view class="page">
  <view class="nav-bar">
    <view class="back-btn" catchtap="onBack">
      <image class="back-icon" src="https://svgs1.oss-cn-beijing.aliyuncs.com/svgs/svgs/benefits-back-arrow.svg" mode="aspectFit" />
      <text class="back-text">返回</text>
    </view>
    <text class="nav-title">订单管理</text>
  </view>

  <scroll-view class="list-wrap" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{!loading}}">
    <view wx:if="{{loadError}}" class="empty">
      <text class="empty-text">{{loadError}}</text>
    </view>

    <block wx:elif="{{list.length === 0}}">
      <view class="empty">
        <text class="empty-icon">📦</text>
        <text class="empty-text">暂无订单</text>
        <text class="empty-hint">在商城下单后会显示在这里</text>
      </view>
    </block>

    <block wx:else>
      <view class="order-card" wx:for="{{list}}" wx:key="id">
        <view class="order-top">
          <text class="order-no">订单号 {{item.orderNo}}</text>
          <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text class="order-preview">{{item.itemsPreview}}</text>
        <view class="order-mid">
          <text class="order-time">{{item.timeText}}</text>
          <text class="order-amount">¥{{item.totalText}}</text>
        </view>
        <view class="order-actions" wx:if="{{item.canCancel || item.status === 0 || item.status === 1 || item.status === 2}}">
          <!-- 取消订单按钮（仅待付款、待发货可取消） -->
          <view wx:if="{{item.canCancel}}" class="btn-cancel" catchtap="onCancel" data-id="{{item.id}}">
            <text>取消订单</text>
          </view>
            <!-- AI 待发货（status=1）显示发货按钮（演示） -->
          <view wx:if="{{item.status === 1}}" class="btn-pay" catchtap="onShipOrder" data-id="{{item.id}}">
            <text>{{ shippingOrderId === item.id ? '发货中...' : '发货' }}</text>
          </view>
          <!-- 去支付按钮（仅待付款） -->
          <view wx:if="{{item.status === 0}}" class="btn-pay" catchtap="onPayOrder" data-id="{{item.id}}">
            <text>{{ payingOrderId === item.id ? '支付中...' : '去支付' }}</text>
          </view>
          <!-- AI 新增：已发货（status=2）显示查看物流 -->
          <view wx:if="{{item.status === 2}}" class="btn-logistics" catchtap="onViewLogistics" data-id="{{item.id}}">
            <text>查看物流</text>
          </view>
        </view>
      </view>
    </block>
    <view class="list-bottom" />
  </scroll-view>

  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>
</view>