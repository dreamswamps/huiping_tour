.page {
  min-height: 100vh;
  background: #f8f5f0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 22rpx 16rpx;
}

.back-btn {
  position: absolute;
  left: 22rpx;
  display: flex;
  align-items: center;
  width: 192rpx;
  height: 82rpx;
  background: #f5e4e1;
  border-radius: 30rpx;
  padding-left: 28rpx;
}

.back-icon {
  width: 26rpx;
  height: 26rpx;
}

.back-text {
  margin-left: 18rpx;
  font-size: 32rpx;
  color: #c91f37;
}

.nav-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #c91f37;
  /* margin-top: 8rpx; */
}

.delivery-mode {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx 16rpx;
}

.delivery-mode-text {
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #777;
}

.list-wrap {
  height: calc(100vh - 280rpx);
  padding: 0 26rpx;
  box-sizing: border-box;
}

.loading-mask {
  padding: 120rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 30rpx;
  color: #212121;
  font-weight: 600;
  text-align: center;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}

.order-card {
  background: #fff;
  border-radius: 40rpx;
  border: 2rpx solid #e3e3e3;
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx 22rpx;
  box-sizing: border-box;
}

.order-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 24rpx;
  color: #888;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  word-break: break-all;
}

.order-status {
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.order-status--muted {
  color: #999;
}

.order-status--warn {
  color: #c91f37;
}

.order-status--ok {
  color: #2e7d32;
}

.order-preview {
  font-size: 28rpx;
  color: #333;
  line-height: 1.45;
  display: block;
  margin-bottom: 16rpx;
}

.order-mid {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  font-size: 24rpx;
  color: #aaa;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: #c91f37;
}

/* ---------- 操作按钮区域（支持多个按钮） ---------- */
.order-actions {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;               /* 按钮间距（微信小程序支持 gap） */
}

/* 取消按钮（灰色边框） */
.btn-cancel {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid #c91f37;
  background: transparent;
}

.btn-cancel text {
  font-size: 26rpx;
  color: #c91f37;
}

/* 支付按钮（红色填充，更醒目） */
.btn-pay {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid #c91f37;
  background: #c91f37;
  transition: opacity 0.2s;
}

.btn-pay text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.btn-pay:active {
  opacity: 0.7;
}

.btn-cancel:active {
  opacity: 0.7;
}

.list-bottom {
  height: 40rpx;
}

/* 查看物流按钮（中性灰） */
.btn-logistics {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ccc;
  background: transparent;
}
.btn-logistics text {
  font-size: 26rpx;
  color: #666;
}
.btn-logistics:active {
  opacity: 0.7;
}