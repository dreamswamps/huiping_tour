<!-- 编辑 / 新建收货地址 -->
<view class="page">
  <view class="nav-bar">
    <view class="back-btn" catchtap="onBack">
      <image class="back-icon" src="{{svgsUrl}}/svgs/svgs/benefits-back-arrow.svg" mode="aspectFit"></image>
      <text class="back-text">返回</text>
    </view>
    <text class="nav-title">{{isEdit ? '编辑地址' : '新增地址'}}</text>
  </view>

  <scroll-view class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="form-card">
      <view class="field">
        <text class="label">收货人</text>
        <input class="input" placeholder="请填写姓名" value="{{receiverName}}" data-field="receiverName" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="请填写手机号" value="{{receiverPhone}}" data-field="receiverPhone" bindinput="onInput" />
      </view>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="field picker-field">
          <text class="label">所在地区</text>
          <view class="picker-value-wrap">
            <text class="picker-value {{regionText ? '' : 'placeholder'}}">{{regionText || '请选择省市区'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </view>
      </picker>
      <view class="field field-block">
        <text class="label">详细地址</text>
        <textarea
          class="textarea"
          placeholder="街道、楼牌号等"
          value="{{detailAddress}}"
          data-field="detailAddress"
          bindinput="onInput"
          maxlength="120"
          auto-height
        />
      </view>
      <view class="field">
        <text class="label">标签</text>
        <input class="input" placeholder="选填，如：家、公司" value="{{label}}" data-field="label" bindinput="onInput" />
      </view>
      <view class="field field-switch">
        <text class="label">设为默认地址</text>
        <switch color="#C91F37" checked="{{isDefault}}" bindchange="onDefaultChange" />
      </view>
    </view>
    <view class="form-bottom"></view>
  </scroll-view>

  <view class="footer-bar">
    <button class="btn-save" hover-class="btn-save-hover" bindtap="onSave">保存</button>
  </view>
</view>
