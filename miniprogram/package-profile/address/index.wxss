.page {
  min-height: 100vh;
  background: #f8f5f0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 22rpx 16rpx;
}

.back-btn {
  position: absolute;
  left: 22rpx;
  display: flex;
  align-items: center;
  width: 192rpx;
  height: 82rpx;
  background: #f5e4e1;
  border-radius: 30rpx;
  padding-left: 28rpx;
}

.back-icon {
  width: 26rpx;
  height: 26rpx;
}

.back-text {
  margin-left: 18rpx;
  font-size: 32rpx;
  color: #c91f37;
}

.nav-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #c91f37;
  margin-top: 8rpx;
}

.list-wrap {
  height: calc(100vh - 280rpx);
  padding: 0 26rpx;
  box-sizing: border-box;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 30rpx;
  color: #212121;
  font-weight: 600;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}

.addr-card {
  background: #fff;
  border-radius: 40rpx;
  border: 2rpx solid #e3e3e3;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.addr-top {
  padding: 28rpx 26rpx 20rpx;
}

.addr-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #212121;
}

.addr-phone {
  font-size: 28rpx;
  color: #666;
}

.tag-default {
  font-size: 22rpx;
  color: #fff;
  background: #c91f37;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.addr-full {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-top: 14rpx;
}

.addr-label {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8b6914;
  background: #f9f7f3;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  padding: 16rpx 26rpx 22rpx;
  border-top: 2rpx solid #f0f0f0;
}

.act-link {
  font-size: 26rpx;
  color: #c91f37;
}

.act-link.danger {
  color: #999;
}

.list-bottom {
  height: 24rpx;
}

.loading-mask {
  padding: 80rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248, 245, 240, 0) 0%, #f8f5f0 28%);
}

.btn-add {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  border: 2rpx solid rgba(230, 194, 136, 0.65);
  background: linear-gradient(180deg, #fff9f0 0%, #f0dfc4 55%, #e6c288 100%);
  font-size: 30rpx;
  font-weight: 700;
  color: #4a0d14;
  padding: 0;
  margin: 0;
}

.btn-add::after {
  border: none;
}

.btn-add-hover {
  opacity: 0.92;
}
