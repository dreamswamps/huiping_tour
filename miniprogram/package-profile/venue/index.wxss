.page {
  min-height: 100vh;
  background: #f8f5f0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.nav-bar {
  padding: 20rpx 22rpx 16rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  width: 192rpx;
  height: 82rpx;
  background: #f5e4e1;
  border-radius: 30rpx;
  padding-left: 28rpx;
}

.back-icon {
  width: 26rpx;
  height: 26rpx;
}

.back-text {
  margin-left: 18rpx;
  font-size: 32rpx;
  color: #c91f37;
}

.nav-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #c91f37;
  margin-top: 8rpx;
}

.list-wrap {
  height: calc(100vh - 280rpx);
  padding: 0 26rpx;
  box-sizing: border-box;
}

.loading-mask {
  padding: 120rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 30rpx;
  color: #212121;
  font-weight: 600;
  text-align: center;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}

.venue-card {
  background: #fff;
  border-radius: 40rpx;
  border: 2rpx solid #e3e3e3;
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx 22rpx;
  box-sizing: border-box;
}

.venue-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.venue-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #212121;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.venue-status {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.status--ok {
  color: #2e7d32;
}

.status--muted {
  color: #999;
}

.venue-info {
  margin-top: 8rpx;
}

.venue-date {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.list-bottom {
  height: 40rpx;
}
