<view class="page">
  <view class="nav-bar">
    <view class="back-btn" catchtap="onBack">
      <image class="back-icon" src="https://svgs1.oss-cn-beijing.aliyuncs.com/svgs/svgs/benefits-back-arrow.svg" mode="aspectFit" />
      <text class="back-text">返回</text>
    </view>
    <text class="nav-title">场馆预约</text>
  </view>

  <scroll-view class="list-wrap" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{!loading}}">
    <view wx:if="{{loadError}}" class="empty">
      <text class="empty-text">{{loadError}}</text>
    </view>

    <block wx:elif="{{list.length === 0}}">
      <view class="empty">
        <text class="empty-icon">🏟️</text>
        <text class="empty-text">暂无预约</text>
        <text class="empty-hint">预约场馆后会显示在这里</text>
      </view>
    </block>

    <block wx:else>
      <view class="venue-card" wx:for="{{list}}" wx:key="id">
        <view class="venue-top">
          <text class="venue-name">{{item.venueName || item.name}}</text>
          <text class="venue-status {{item.status === 1 ? 'status--ok' : 'status--muted'}}">{{item.statusText || '已预约'}}</text>
        </view>
        <view class="venue-info">
          <text class="venue-date">预约日期：{{item.bookingDate || item.date || '---'}}</text>
        </view>
        <view class="venue-info" wx:if="{{item.timeSlot || item.time}}">
          <text class="venue-date">时段：{{item.timeSlot || item.time}}</text>
        </view>
      </view>
    </block>
    <view class="list-bottom" />
  </scroll-view>

  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>
</view>
