.page {
  min-height: 100vh;
  background: #f8f5f0;
  position: relative;
}
.bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 340rpx;
  background: linear-gradient(
    180deg,
    #a80101 0%,
    #c91f37 60%,
    rgba(168, 1, 1, 0) 100%
  );
  z-index: 0;
}
.header {
  position: relative;
  z-index: 1;
  padding: 80rpx 40rpx 40rpx;
  text-align: center;
}
.header-back {
  position: absolute;
  left: 30rpx;
  top: 60rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 6rpx;
}
.header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}
.badge-list {
  position: relative;
  z-index: 1;
  padding: 20rpx 32rpx 60rpx;
}
.badge-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: row;
}
.badge-image-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #f8f5f0;
  position: relative;
}
.badge-image {
  width: 100%;
  height: 100%;
}
.badge-info {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.badge-num {
  font-size: 20rpx;
  color: #d4a017;
  font-weight: 600;
  letter-spacing: 3rpx;
}
.badge-title {
  font-size: 36rpx;
  color: #a80101;
  font-weight: 700;
  margin-top: 6rpx;
}
.badge-name {
  font-size: 26rpx;
  color: #c8a87a;
  margin-top: 4rpx;
}
.badge-desc {
  font-size: 22rpx;
  color: #9e9e9e;
  margin-top: 8rpx;
}

.back-text {
  font-size: 64rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

.badge-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(180, 180, 180, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-status {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
  background: rgba(100, 100, 100, 0.7);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}
.badge-card {
  filter: grayscale(0.6);
}
.badge-card .badge-title {
  color: #999 !important;
}
.badge-card .badge-name,
.badge-card .badge-desc {
  color: #bbb !important;
}

.badge-card.obtained {
  filter: grayscale(0);
}
.badge-card.obtained .badge-title {
  color: #a80101 !important;
}
.badge-card.obtained .badge-name {
  color: #c8a87a !important;
}
.badge-card.obtained .badge-desc {
  color: #9e9e9e !important;
}
.badge-overlay.obtained {
  background: rgba(76, 175, 80, 0.3);
}
.badge-status.obtained {
  background: rgba(76, 175, 80, 0.85);
}
