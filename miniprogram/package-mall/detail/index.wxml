<view class="page">
  <view wx:if="{{galleryUrls.length > 0}}" class="hero-swiper-wrap">
    <swiper
      class="hero-swiper"
      indicator-dots="{{galleryUrls.length > 1}}"
      indicator-color="rgba(255,255,255,0.35)"
      indicator-active-color="#ffffff"
      circular="{{galleryUrls.length > 1}}"
      autoplay="{{galleryUrls.length > 1}}"
      interval="5000"
    >
      <swiper-item wx:for="{{galleryUrls}}" wx:key="*this">
        <image class="hero-swiper-img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>
  <view wx:else class="hero-bg" />

  <view class="nav-bar">
    <view class="nav-row">
      <image class="nav-icon" src="{{baseUrl}}/img/svgs/mall-detail-back.svg" mode="aspectFit" bindtap="onBack" />
      <button class="nav-share-wrap" open-type="share" hover-class="none">
        <image class="nav-icon" src="{{baseUrl}}/img/svgs/mall-detail-share.svg" mode="aspectFit" />
      </button>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loadError}}" class="err-box">
      <text>{{loadError}}</text>
    </view>

    <view wx:elif="{{!loading && detail}}" class="sheet">
      <view class="info-card">
        <text class="info-title">{{detail.productName}}</text>
        <view wx:if="{{subtitleTagList.length}}" class="tag-row">
          <view wx:for="{{subtitleTagList}}" wx:key="*this" class="tag-pill">
            <text>{{item}}</text>
          </view>
        </view>
        <text wx:if="{{detail.description}}" class="info-desc">{{detail.description}}</text>
        <text wx:if="{{priceText}}" class="info-price">¥{{priceText}}</text>
      </view>

      <view wx:if="{{attrList.length}}" class="params-card">
        <view class="block-title">
          <view class="block-title-bar" />
          <text class="block-title-text">产品参数</text>
        </view>
        <block wx:for="{{attrList}}" wx:for-item="row" wx:key="key">
          <view class="param-row">
            <text class="param-k">{{row.key}}</text>
            <text class="param-v">{{row.value}}</text>
          </view>
          <view class="param-line" />
        </block>
      </view>

      <view wx:if="{{detail.content}}" class="detail-html-wrap">
        <view class="package-head">
          <view class="block-title-bar block-title-bar--sm" />
          <text class="package-title">详情</text>
        </view>
        <rich-text class="detail-rich" nodes="{{detail.content}}" />
      </view>

      <view class="page-footer">
        <image class="footer-deco" src="{{baseUrl}}/img/svgs/mall-footer-deco.svg" mode="widthFix" />
        <text class="footer-text">传薪茶社 · 品传薪茶，续红色魂</text>
      </view>

      <view class="scroll-bottom-space" />
    </view>

    <view wx:elif="{{loading}}" class="loading-box">
      <text>加载中…</text>
    </view>
  </scroll-view>

  <view wx:if="{{detail && !loadError}}" class="detail-actions">
    <view class="detail-actions-inner">
      <view class="fab-cart fab-cart--inline" bindtap="onFabCart">
        <image class="fab-icon" src="{{baseUrl}}/img/svgs/mall-fab-cart-icon.svg" mode="aspectFit" />
        <text class="fab-label">购物车</text>
      </view>
      <view class="action-btn action-btn--cart" bindtap="onAddCart">
        <text>加入购物车</text>
      </view>
      <view class="action-btn action-btn--buy" bindtap="onBuyNow">
        <text>立即购买</text>
      </view>
    </view>
  </view>

  <mall-figma-tip id="mallFigmaTip" />
</view>
