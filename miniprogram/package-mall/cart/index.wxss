.page {
  height: 100vh;
  background: #f8f5f0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.header {
  flex-shrink: 0;
  background: #c91f37;
}

.header-inner {
  padding-top: env(safe-area-inset-top);
}

.header-bar {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.header-back {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.header-placeholder {
  width: 70rpx;
  flex-shrink: 0;
}

.main--empty {
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  padding-bottom: calc(320rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f8f5f0;
}

.empty-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-circle {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e44d3a 0%, #8a1a1a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 72rpx rgba(138, 26, 26, 0.22);
  box-sizing: border-box;
}

.empty-circle-icon {
  width: 156rpx;
  height: 150rpx;
}

.empty-text {
  margin-top: 54rpx;
  font-size: 42rpx;
  font-weight: 500;
  color: #999999;
  line-height: 1.4;
}

.list-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.cart-list {
  padding-bottom: calc(320rpx + env(safe-area-inset-bottom));
}

.cart-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 24rpx 20rpx 24rpx 16rpx;
  margin-bottom: 24rpx;
  background: #fdfaf5;
  border: 1rpx solid #eadcd3;
  border-radius: 40rpx;
  box-sizing: border-box;
}

.row-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  flex-shrink: 0;
  padding-right: 8rpx;
}

.row-thumb {
  width: 202rpx;
  height: 198rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #a80101;
}

.row-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.row-name {
  font-size: 40rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.2;
}

.row-spec {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #bdbdbd;
  line-height: 1.25;
}

.row-foot {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}

.row-price {
  font-size: 32rpx;
  font-weight: 400;
  color: #c91f37;
  line-height: 1.2;
}

.row-qty {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.qty-btn {
  width: 40rpx;
  height: 40rpx;
  margin: 0 6rpx;
}

.qty-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  line-height: 44rpx;
}

.checkout-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: 16rpx;
  background: #fef6f1;
  box-sizing: border-box;
  z-index: 999;
}

.checkout-bar {
  margin: 0 20rpx;
  min-height: 120rpx;
  border: 2rpx solid #e3e3e3;
  border-radius: 8rpx;
  background: #fef6f1;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 8rpx 8rpx 8rpx 24rpx;
  box-sizing: border-box;
}

.checkout-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  align-self: center;
}

.check-ring {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #a80101;
  background: #fdfaf5;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.check-ring--on {
  border-color: #a80101;
  background: #fdfaf5;
}

.check-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #a80101;
}

.check-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #444444;
}

.total-wrap {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  padding-right: 16rpx;
  align-self: center;
}

.total-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #444444;
}

.total-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #c91f37;
}

.checkout-btn {
  width: 198rpx;
  background: #c91f37;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkout-btn text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}
