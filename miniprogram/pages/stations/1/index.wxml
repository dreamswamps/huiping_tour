<view class="page">

  <!-- 顶部背景图 -->
  <image class="top-bg" src="{{baseUrl}}/img/station1-top-bg.png" mode="widthFix"></image>

  <!-- 返回首页按钮 -->
  <view class="back-home-btn" bindtap="onBackHome">
    <image class="home-icon" src="{{baseUrl}}/img/station1-btn-home.svg" mode="aspectFit"></image>
    <text>返回首页</text>
  </view>

  <!-- 圆角内容容器 -->
  <view class="content-panel">

    <!-- 站点信息 -->
    <view class="station-info">
      <view class="station-num-wrap">
        <text class="num-line"></text>
        <text class="station-num">{{stationNum}}</text>
        <text class="num-line"></text>
      </view>
      <text class="station-title">{{stationTitle}}</text>
      <text class="station-name">{{stationName}}</text>
      <text class="station-desc">{{stationDesc}}</text>
    </view>

    <!-- 点亮初心火种卡片 -->
    <view class="ar-card">
      <view class="ar-header">
        <text class="ar-icon">✨</text>
        <view class="ar-title-wrap">
          <text class="ar-title">点亮初心火种</text>
          <text class="ar-sub">AR扫描体验·互动点亮</text>
        </view>
      </view>
      <text class="ar-desc">用手机扫描现场指定AR标识，手指触碰屏幕中的金色火种，将它点亮，完成第一站打卡。</text>
      <view class="ar-btn" bindtap="onArScan">
        <image class="ar-btn-icon" src="{{baseUrl}}/img/station1-ar-flame.svg" mode="aspectFit"></image>
        <text>点亮初心火种·AR扫描</text>
      </view>
    </view>

    <!-- 收听广播剧卡片 -->
    <view class="radio-card" bindtap="onPlayRadio">
      <view class="radio-left">
        <view class="radio-icon-wrap">
          <image class="radio-main-icon" src="{{baseUrl}}/img/station1-card-radio.svg" mode="aspectFit"></image>
          <image class="radio-sub-icon" src="{{baseUrl}}/img/station1-card-radiolabel.svg" mode="aspectFit"></image>
        </view>
        <view class="radio-text-wrap">
          <text class="radio-title">收听广播剧</text>
          <text class="radio-sub">《夜袭镇公所》· 革命故事</text>
        </view>
      </view>
      <image class="play-icon" src="{{baseUrl}}/img/station1-play-arrow.svg" mode="aspectFit"></image>
    </view>

    <!-- 返回地图 -->
    <view class="back-map-btn" bindtap="onBackToMap">
      <text>返回地图</text>
    </view>

  </view>

</view>
