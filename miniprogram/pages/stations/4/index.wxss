/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #F8F5F0;
  position: relative;
}

/* ==================== 顶部背景 ==================== */
.top-bg {
  width: 100%;
  height: auto;
  display: block;
}

/* ==================== 返回首页按钮（fixed） ==================== */
.back-home-btn {
  position: fixed;
  top: 44rpx;
  left: 34rpx;
  width: 192rpx;
  height: 68rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 0 5rpx rgba(88, 5, 5, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.home-icon {
  width: 30rpx;
  height: 30rpx;
}
.back-home-btn text {
  font-size: 24rpx;
  color: #C91F37;
}

/* ==================== 圆角内容面板 ==================== */
.content-panel {
  margin-top: -40rpx;
  background: #F8F5F0;
  border-top-left-radius: 80rpx;
  border-top-right-radius: 80rpx;
  padding: 60rpx 56rpx 80rpx;
  position: relative;
  z-index: 1;
}

/* ==================== 站点信息 ==================== */
.station-info {
  text-align: center;
  margin-bottom: 40rpx;
}
.station-num-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.num-line {
  width: 112rpx;
  height: 2rpx;
  background: #D4A017;
}
.station-num {
  font-size: 28rpx;
  color: #D4A017;
  letter-spacing: 4rpx;
  margin: 0 16rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #D4A017;
  letter-spacing: 5rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-name {
  display: block;
  font-size: 32rpx;
  color: #C8A87A;
  margin-top: 14rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-desc {
  display: block;
  font-size: 28rpx;
  color: #C8A87A;
  line-height: 1.6;
  margin-top: 24rpx;
  padding: 0 10rpx;
  font-family: 'Noto Sans SC', sans-serif;
}

/* ==================== AR卡片（献花致敬英雄） ==================== */
.ar-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.ar-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.ar-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.ar-title-wrap {
  display: flex;
  flex-direction: column;
}
.ar-title {
  font-size: 28rpx;
  color: #C91F37;
  font-weight: 700;
}
.ar-sub {
  font-size: 24rpx;
  color: #5C3A21;
  margin-top: 4rpx;
}
.ar-desc {
  display: block;
  font-size: 24rpx;
  color: #5C3A21;
  line-height: 1.6;
  margin-bottom: 22rpx;
}
.ar-btn {
  width: 100%;
  height: 76rpx;
  background: linear-gradient(274deg, #CE3B45 3%, #E4B983 46%, #CD3542 76%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ar-btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.ar-btn text {
  font-size: 28rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 薪火传递卡片 ==================== */
.torch-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
.torch-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.torch-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.torch-text-wrap {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}
.torch-title {
  font-size: 28rpx;
  color: #5C3A21;
  font-weight: 700;
}
.torch-hint {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-top: 4rpx;
}
.torch-desc {
  display: block;
  font-size: 24rpx;
  color: #5C3A21;
  line-height: 1.6;
  margin-bottom: 22rpx;
}
.torch-btn {
  width: 100%;
  height: 98rpx;
  background: linear-gradient(314deg, #E3B481 0%, #CC3241 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.torch-btn-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
}
.torch-btn text {
  font-size: 30rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 传薪人证书卡片 ==================== */
.cert-card {
  width: 100%;
  background: #FBFBFB;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cert-left {
  display: flex;
  align-items: center;
}
.cert-icons {
  width: 44rpx;
  height: 50rpx;
  position: relative;
  flex-shrink: 0;
}
.cert-main-icon {
  width: 38rpx;
  height: 38rpx;
}
.cert-sub-icon {
  width: 32rpx;
  height: 32rpx;
  position: absolute;
  left: 2rpx;
  top: 12rpx;
}
.cert-text-wrap {
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}
.cert-title {
  font-size: 28rpx;
  color: #5C3A21;
  font-weight: 700;
}
.cert-hint {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-top: 4rpx;
}
/* 已解锁状态 */
.cert-card.unlocked {
  background: #FFF9E6;
  border: 2rpx solid #D4A017;
}
.cert-card.unlocked .cert-title { color: #D4A017; }
.cert-card.unlocked .cert-hint { color: #5C3A21; }

/* 右侧状态区 */
.cert-status {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cert-lock-icon {
  width: 28rpx;
  height: 28rpx;
}
.cert-status text {
  font-size: 24rpx;
  color: #9E9E9E;
  font-weight: 700;
  margin-top: 2rpx;
}
.cert-card.unlocked .cert-status text {
  color: #D4A017;
}

/* ==================== 去这里导航按钮 ==================== */
.nav-btn {
  width: 636rpx;
  height: 88rpx;
  background: linear-gradient(274deg, #CE3B45 3%, #E4B983 46%, #CD3542 76%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
}
.nav-btn text {
  font-size: 32rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 返回地图 ==================== */
.back-map-btn {
  width: 100%;
  height: 88rpx;
  background: #F3E1D6;
  border-radius: 40rpx;
  border: 1rpx solid rgba(168, 1, 1, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-map-btn text {
  font-size: 32rpx;
  color: #C91F37;
}
