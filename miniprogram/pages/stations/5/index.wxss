/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #F8F5F0;
  position: relative;
}

/* ==================== 顶部背景 ==================== */
.top-bg {
  width: 100%;
  height: auto;
  display: block;
}

/* ==================== 返回首页按钮（fixed） ==================== */
.back-home-btn {
  position: fixed;
  top: 44rpx;
  left: 34rpx;
  width: 192rpx;
  height: 68rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 0 5rpx rgba(88, 5, 5, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.home-icon {
  width: 30rpx;
  height: 30rpx;
}
.back-home-btn text {
  font-size: 24rpx;
  color: #C91F37;
}

/* ==================== 圆角内容面板 ==================== */
.content-panel {
  margin-top: -40rpx;
  background: #F8F5F0;
  border-top-left-radius: 80rpx;
  border-top-right-radius: 80rpx;
  padding: 60rpx 56rpx 80rpx;
  position: relative;
  z-index: 1;
}

/* ==================== 站点信息 ==================== */
.station-info {
  text-align: center;
  margin-bottom: 40rpx;
}
.station-num-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.num-line {
  width: 112rpx;
  height: 2rpx;
  background: #D4A017;
}
.station-num {
  font-size: 28rpx;
  color: #D4A017;
  letter-spacing: 4rpx;
  margin: 0 16rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #D4A017;
  letter-spacing: 5rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-name {
  display: block;
  font-size: 32rpx;
  color: #C8A87A;
  margin-top: 14rpx;
  font-family: 'Noto Sans SC', sans-serif;
}
.station-desc {
  display: block;
  font-size: 28rpx;
  color: #C8A87A;
  line-height: 1.6;
  margin-top: 24rpx;
  padding: 0 10rpx;
  font-family: 'Noto Sans SC', sans-serif;
}

/* ==================== 宣言卡片（带红色边框） ==================== */
.declaration-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  border: 2rpx solid #C91F37;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.decl-header {
  background: #FDF8F9;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #EED2D6;
  display: flex;
  align-items: center;
}
.decl-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.decl-title {
  font-size: 28rpx;
  color: #C91F37;
  font-weight: 700;
}
.decl-input-wrap {
  padding: 26rpx 22rpx 30rpx;
  background: #F8F5F0;
  border-radius: 30rpx;
  margin: 20rpx 18rpx;
  border: 2rpx solid #FADDE1;
}
.decl-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}
.input-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}
.char-count, .pub-status {
  font-size: 24rpx;
  color: #BDBDBD;
}
.publish-btn {
  width: 100%;
  height: 110rpx;
  background: #E0E0E0;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}
.publish-btn.active {
  background: linear-gradient(135deg, #C91F37, #E04A5F);
}
.pub-btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.publish-btn text {
  font-size: 30rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 宣言墙卡片 ==================== */
.wall-card {
  width: 100%;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.25);
  border: 2rpx solid #EED2D6;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.wall-header {
  background: #FDF8F9;
  padding: 22rpx 30rpx;
  border-bottom: 1rpx solid #EED2D6;
  display: flex;
  align-items: center;
}
.wall-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.wall-title {
  font-size: 28rpx;
  color: #C91F37;
  font-weight: 700;
}
.wall-viewport {
  height: 300rpx;
  overflow: hidden;
  position: relative;
}
.wall-state {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.wall-state text {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
}
.wall-scroll-wrap {
  height: 100%;
  overflow: hidden;
}
.wall-scroll-inner {
  will-change: transform;
}
.wall-scroll-animate {
  animation-name: wallScrollUp;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
@keyframes wallScrollUp {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-50%);
  }
}
.wall-list {
  padding: 20rpx 24rpx;
}
.wall-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.wall-item:last-child {
  border-bottom: none;
}
.wall-content {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
.wall-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ==================== 返回地图 ==================== */
.back-map-btn {
  width: 100%;
  height: 88rpx;
  background: #F3E1D6;
  border-radius: 40rpx;
  border: 1rpx solid rgba(168, 1, 1, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-map-btn text {
  font-size: 32rpx;
  color: #C91F37;
}
