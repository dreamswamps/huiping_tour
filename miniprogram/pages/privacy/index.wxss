/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #f8f5f0;
}

/* ==================== 顶部导航栏 ==================== */
.nav-bar {
  position: relative;
  padding: 20rpx 22rpx 16rpx;
  padding-top: calc(80rpx + env(safe-area-inset-top));
}

.back-btn {
  display: flex;
  align-items: center;
  width: 192rpx;
  height: 82rpx;
  background: #f5e4e1;
  border-radius: 30rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
}
.back-text {
  font-size: 32rpx;
  color: #c91f37;
  font-weight: 400;
}

.page-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #c91f37;
  margin-top: 8rpx;
}

/* ==================== 政策正文 ==================== */
.doc-body {
  height: calc(100vh - 180rpx - env(safe-area-inset-top));
}

.doc-inner {
  padding: 28rpx 32rpx 0;
}

.doc-updated {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 32rpx;
}

.sec-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.sec-body {
  display: block;
  font-size: 27rpx;
  color: #555555;
  line-height: 1.8;
  text-align: justify;
}

.safe-bottom {
  height: 60rpx;
}
