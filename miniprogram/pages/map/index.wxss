/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #F8F5F0;
}

/* ==================== 顶部导航 ==================== */
.map-header {
  padding: 20rpx 32rpx 16rpx;
}

.header-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #C91F37;
}

.header-sub {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #5C3A21;
  margin-top: 14rpx;
  line-height: 1.4;
}

/* ==================== 滚动内容区 ==================== */
.map-body {
  height: calc(100vh - 180rpx);
  overflow-y: auto;
}

/* ==================== 站点列表 ==================== */
.station-list {
  padding: 0 30rpx;
  position: relative;
}

/* ---- 站点行（左右布局） ---- */
.station-row {
  position: relative;
  display: flex;
}
.station-row + .station-row {
  margin-top: -70rpx; /* 下一个卡片顶部对齐上一个卡片1/3处 (300rpx*2/3) */
}
.row-left   { justify-content: flex-start; }
.row-right  { justify-content: flex-end; }

/* ---- 卡片容器（relative定位基准） ---- */
.station-card-wrap {
  width: 300rpx;
  position: relative;
}

/* ---- 卡片：纯白 + 红色边框 ---- */
.station-card {
  width: 300rpx;
  height: 300rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 6rpx solid #A80101;
  box-sizing: border-box;
}

/* ---- 站点信息（绝对定位，覆盖在卡片上） ---- */
.station-info {
  position: absolute;
  left: 16rpx;
  top: 44rpx;
  width: 270rpx;
}
.info-right {
  left: auto;
  right: 16rpx;
  text-align: right;
}

/* 编号行：第X站 · 名称 */
.info-row-num {
  display: flex;
  align-items: center;
}
.info-right .info-row-num {
  justify-content: flex-end;
}
.info-num {
  font-size: 24rpx;
  color: #9E9E9E;
}
.info-dot {
  font-size: 24rpx;
  color: #C0C0C0;
  margin: 0 6rpx;
}
.info-name {
  font-size: 24rpx;
  color: #9E9E9E;
}

/* 状态标签（可打卡 / 进行中） */
.status-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #C91F37;
  font-weight: 700;
  margin-top: 4rpx;
}

/* 标题：红色粗体 */
.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #C91F37;
  margin-top: 14rpx;
  line-height: 1.3;
}

/* 描述：棕色 */
.info-desc {
  display: block;
  font-size: 24rpx;
  color: #5C3A21;
  margin-top: 6rpx;
  line-height: 1.3;
}

/* 进入站点链接 */
.enter-link {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.info-right .enter-link {
  justify-content: flex-end;
}
.enter-link text {
  font-size: 24rpx;
  color: #C91F37;
}
.enter-arrow {
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
}

.safe-bottom-lg {
  height: 140rpx;
}
