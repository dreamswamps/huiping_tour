/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #F8F5F0;
  display: flex;
  flex-direction: column;
}

/* ==================== 顶部导航 ==================== */
.map-header {
  padding: 20rpx 32rpx 16rpx;
}

/* 返回首页按钮 */
.back-btn {
  display: inline-flex;
  align-items: center;
  background: #fff;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(88, 5, 5, 0.15);
}
.back-icon {
  width: 28rpx;
  height: 28rpx;
}
.back-btn text {
  font-size: 24rpx;
  color: #C91F37;
  margin-left: 10rpx;
}

/* 标题 */
.header-title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #C91F37;
  margin-top: 6rpx;
}

/* 副标题 */
.header-sub {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #5C3A21;
  margin-top: 14rpx;
  line-height: 1.4;
}

/* ==================== 滚动内容区 ==================== */
.map-body {
  flex: 1;
  overflow-y: auto;
}

/* ==================== 站点列表 ==================== */
.station-list {
  padding: 0 30rpx;
  position: relative;
}

/* ---- 站点行（左右布局） ---- */
.station-row {
  position: relative;
  display: flex;
  min-height: 300rpx;
}
.row-left   { justify-content: flex-start; padding-right: 50rpx; }
.row-right  { justify-content: flex-end;  padding-left: 50rpx; }

/* ---- 卡片容器 ---- */
.station-card-wrap {
  width: 300rpx;
  position: relative;
}
.card-left  { align-self: flex-start; }
.card-right { align-self: flex-end; }

/* ---- 卡片：白色圆角 + 红色边框 ---- */
.station-card {
  width: 300rpx;
  height: 300rpx;
  background: #fff;
  border-radius: 40rpx;
  border: 6rpx solid #A80101;
  overflow: hidden;
  box-sizing: border-box;
}
.card-bg {
  width: 100%;
  height: 100%;
  opacity: 0.06;
}

/* ---- 站点信息覆盖层 ---- */
.station-info {
  position: absolute;
  left: 0;
  top: 80rpx;
  width: 270rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
}
.info-right {
  left: auto;
  right: 0;
}

/* 编号行：第X站 · 名称 */
.info-row-num {
  display: flex;
  align-items: center;
}
.info-num {
  font-size: 24rpx;
  color: #9E9E9E;
}
.info-dot {
  font-size: 24rpx;
  color: #C0C0C0;
  margin: 0 6rpx;
}
.info-name {
  font-size: 24rpx;
  color: #9E9E9E;
}

/* 状态标签（可打卡 / 进行中） */
.status-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #C91F37;
  font-weight: 700;
  margin-top: 2rpx;
}
.tag-right {
  position: absolute;
  right: 15rpx;
  top: 0;
}

/* 标题：红色粗体 */
.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #C91F37;
  margin-top: 18rpx;
  line-height: 1.3;
}

/* 描述：棕色 */
.info-desc {
  display: block;
  font-size: 24rpx;
  color: #5C3A21;
  margin-top: 8rpx;
  line-height: 1.3;
}

/* 进入站点链接 */
.enter-link {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}
.enter-link text {
  font-size: 24rpx;
  color: #C91F37;
}
.enter-arrow {
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
}

/* ==================== 连接线 ==================== */
.connector {
  display: flex;
  justify-content: center;
  height: 60rpx;
  align-items: center;
}
.line-img {
  width: 60rpx;
  height: 56rpx;
}

/* ==================== 底部安全距离 ==================== */
.safe-bottom-lg {
  height: 140rpx;
}
