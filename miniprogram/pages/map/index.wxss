/* 传薪地图 · 手绘稿 1:2（402×874 → rpx×750/402） */
.page {
  min-height: 100vh;
  background: #f8f5f0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.map-header {
  flex-shrink: 0;
  padding: 16rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.header-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  margin-bottom: 8rpx;
}

.back-home {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 20rpx 8rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.back-home-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 8rpx;
}

.back-home-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #c91f37;
}

.header-title {
  display: block;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #c91f37;
  line-height: 1.2;
}

.header-sub-wrap {
  margin-top: 12rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.header-sub {
  display: block;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.45;
  color: #5c3a21;
}

.map-illustration {
  flex-shrink: 0;
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.map-swiper {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.map-illustration-img {
  width: 100%;
  height: 100%;
}

.map-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.map-canvas {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  background: #f8f5f0;
}

.map-routes {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.85;
  pointer-events: none;
}

.station-card {
  position: absolute;
  box-sizing: border-box;
  padding: 0;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 38rpx;
  border: 6rpx solid #a80101;
  overflow: hidden;
  z-index: 2;
}

/* 上图下文；插图区 flex 增高后配合 aspectFit 完整露图（上下可留白） */
.card-thumb {
  display: block;
  flex: 1;
  width: 100%;
  min-height: 0;
  height: 0;
  background: #f0ebe4;
}

/* 陈列馆、红军村缩略图在框内略下移 */
.card-thumb--shift-down {
  transform: translateY(18rpx);
}

.card-body {
  position: relative;
  flex-shrink: 0;
  padding: 12rpx 14rpx 14rpx;
  box-sizing: border-box;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 3;
  font-size: 20rpx;
  font-weight: 700;
  color: #c91f37;
  line-height: 1.2;
  text-shadow: 0 0 8rpx rgba(255, 255, 255, 0.95);
}

.badge--active {
  color: #a80101;
}

.station-line1 {
  display: block;
  font-size: 22rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 72rpx;
  box-sizing: border-box;
}

.station-title {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #c91f37;
  line-height: 1.3;
}

.enter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
}

.enter-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #c91f37;
}

.enter-arrow {
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
}

.safe-bottom-lg {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
