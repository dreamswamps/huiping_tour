.page {
  min-height: 100vh;
  background: #f8f5f0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  flex-shrink: 0;
  background: #c91f37;
}

.header-inner {
  padding-top: env(safe-area-inset-top);
}

.header-bar {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.header-back {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.header-placeholder {
  width: 70rpx;
  height: 70rpx;
}

.err-wrap {
  flex: 1;
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.err-text {
  font-size: 30rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

.err-btn {
  margin-top: 40rpx;
  padding: 20rpx 48rpx;
  background: #c91f37;
  border-radius: 999rpx;
}

.err-btn text {
  font-size: 28rpx;
  color: #fff;
}

.scroll {
  flex: 1;
  height: 0;
  min-height: 200rpx;
}

.block {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.addr-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0ebe4;
}

.addr-row:last-child {
  border-bottom: none;
}

.addr-row--on {
  background: #fff8f5;
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 12rpx;
}

.addr-radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c91f37;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.addr-dot {
  width: 20rpx;
  height: 20rpx;
  background: #c91f37;
  border-radius: 50%;
}

.addr-body {
  flex: 1;
  min-width: 0;
}

.addr-line {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.addr-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.goods-row {
  display: flex;
  flex-direction: row;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ebe4;
}

.goods-row:last-child {
  border-bottom: none;
}

.goods-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.goods-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.goods-foot {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #c91f37;
}

.goods-qty {
  font-size: 24rpx;
  color: #999;
}

.scroll-bottom-space {
  height: 200rpx;
}

.bottom-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.total-wrap {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #c91f37;
}

.submit-btn {
  padding: 22rpx 40rpx;
  background: linear-gradient(90deg, #e54545, #c91f37);
  border-radius: 999rpx;
}

.submit-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.submit-btn--off {
  opacity: 0.45;
}
