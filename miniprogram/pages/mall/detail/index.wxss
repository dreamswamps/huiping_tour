.page {
  min-height: 100vh;
  background: #f8f5f0;
  position: relative;
}

.hero-swiper-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 480rpx;
  z-index: 0;
  background: #3a0a12;
}

.hero-swiper {
  width: 100%;
  height: 480rpx;
}

.hero-swiper-img {
  width: 100%;
  height: 480rpx;
  display: block;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 480rpx;
  background: linear-gradient(180deg, #4e0e1a 12%, #8d2c29 50%, #aa5c49 88%);
  z-index: 0;
}

.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: transparent;
  padding-top: env(safe-area-inset-top);
}

.nav-row {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-icon {
  width: 70rpx;
  height: 70rpx;
}

.nav-share-wrap {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 0;
}

.nav-share-wrap::after {
  display: none;
}

.scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.sheet {
  margin-top: 440rpx;
  padding: 0 32rpx 0;
  background: #f8f5f0;
  border-radius: 48rpx 48rpx 0 0;
  min-height: 400rpx;
}

.loading-box,
.err-box {
  margin-top: 480rpx;
  padding: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #9e9e9e;
}

.info-card {
  margin-top: -36rpx;
  padding: 28rpx 28rpx 32rpx;
  background: #f8f5f0;
  border: 1rpx solid #a80101;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 8rpx rgba(0, 0, 0, 0.25);
}

.info-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #c8161d;
  line-height: 1.35;
}

.tag-row {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-pill {
  padding: 0 18rpx;
  height: 48rpx;
  line-height: 48rpx;
  background: #f4e9d6;
  border: 1rpx solid #dbc9ab;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.tag-pill text {
  font-size: 24rpx;
  font-weight: 700;
  color: #5c3a21;
}

.info-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5c3a21;
  line-height: 1.7;
}

.badge-row {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
}

.badge-item {
  font-size: 24rpx;
  color: #9e9e9e;
  flex: 1;
  min-width: 30%;
  text-align: center;
}

.info-price {
  display: block;
  margin-top: 24rpx;
  font-size: 56rpx;
  font-weight: 900;
  color: #c8161d;
  line-height: 1.2;
}

.params-card {
  margin-top: 36rpx;
  padding: 28rpx 24rpx 32rpx;
  background: #f8f5f0;
  border: 1rpx solid #e3d8c9;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 22rpx rgba(0, 0, 0, 0.25);
}

.block-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.block-title-bar {
  width: 8rpx;
  height: 32rpx;
  background: #c8161d;
  border-radius: 999rpx;
}

.block-title-bar--sm {
  height: 28rpx;
}

.block-title-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #c8161d;
}

.param-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 0 16rpx;
  gap: 24rpx;
}

.param-k {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9e9e9e;
}

.param-v {
  flex: 1;
  font-size: 24rpx;
  color: #5c3a21;
  line-height: 1.45;
}

.param-line {
  height: 1rpx;
  background: #f3e7d8;
  margin-left: 0;
}

.detail-html-wrap {
  margin-top: 40rpx;
  padding: 0 4rpx 24rpx;
}

.detail-rich {
  font-size: 28rpx;
  color: #5c3a21;
  line-height: 1.65;
}

.package-head {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding-left: 4rpx;
}

.package-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #c8161d;
}

.page-footer {
  margin-top: 48rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.footer-deco {
  width: 246rpx;
  height: 22rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #9e9e9e;
  letter-spacing: 0.08em;
}

.scroll-bottom-space {
  height: calc(220rpx + env(safe-area-inset-bottom));
}

.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(254, 246, 241, 0.96);
  border-top: 1rpx solid #e3d8c9;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.detail-actions-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx 20rpx;
  gap: 16rpx;
  box-sizing: border-box;
}

.fab-cart--inline {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  padding: 8rpx 12rpx 4rpx;
}

.fab-cart--inline .fab-icon {
  width: 44rpx;
  height: 42rpx;
}

.fab-cart--inline .fab-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #5c3a21;
  margin-top: 4rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.action-btn--cart {
  background: #f4e9d6;
  color: #a80101;
  border: 1rpx solid #dbc9ab;
}

.action-btn--buy {
  background: #d32029;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(211, 32, 41, 0.3);
}
