.page {
  min-height: 100vh;
  background: #f8f5f0;
  position: relative;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 480rpx;
  background: linear-gradient(
    180deg,
    #4e0e1a 12%,
    #8d2c29 50%,
    #aa5c49 88%
  );
  z-index: 0;
}

.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: transparent;
  padding-top: env(safe-area-inset-top);
}

.nav-row {
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-icon {
  width: 70rpx;
  height: 70rpx;
}

.nav-share-wrap {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 0;
}

.nav-share-wrap::after {
  display: none;
}

.scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.sheet {
  margin-top: 440rpx;
  padding: 0 32rpx 0;
  background: #f8f5f0;
  border-radius: 48rpx 48rpx 0 0;
  min-height: 400rpx;
}

.info-card {
  margin-top: -36rpx;
  padding: 28rpx 28rpx 32rpx;
  background: #f8f5f0;
  border: 1rpx solid #a80101;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 8rpx rgba(0, 0, 0, 0.25);
}

.info-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #c8161d;
  line-height: 1.35;
}

.tag-row {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-pill {
  padding: 0 18rpx;
  height: 48rpx;
  line-height: 48rpx;
  background: #f4e9d6;
  border: 1rpx solid #dbc9ab;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.tag-pill text {
  font-size: 24rpx;
  font-weight: 700;
  color: #5c3a21;
}

.info-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5c3a21;
  line-height: 1.7;
}

.badge-row {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
}

.badge-item {
  font-size: 24rpx;
  color: #9e9e9e;
  flex: 1;
  min-width: 30%;
  text-align: center;
}

.info-price {
  display: block;
  margin-top: 24rpx;
  font-size: 56rpx;
  font-weight: 900;
  color: #c8161d;
  line-height: 1.2;
}

.params-card {
  margin-top: 36rpx;
  padding: 28rpx 24rpx 32rpx;
  background: #f8f5f0;
  border: 1rpx solid #e3d8c9;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 22rpx rgba(0, 0, 0, 0.25);
}

.block-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.block-title-bar {
  width: 8rpx;
  height: 32rpx;
  background: #c8161d;
  border-radius: 999rpx;
}

.block-title-bar--sm {
  height: 28rpx;
}

.block-title-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #c8161d;
}

.param-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 0 16rpx;
  gap: 24rpx;
}

.param-k {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9e9e9e;
}

.param-v {
  flex: 1;
  font-size: 24rpx;
  color: #5c3a21;
  line-height: 1.45;
}

.param-line {
  height: 1rpx;
  background: #f3e7d8;
  margin-left: 0;
}

.package-head {
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding-left: 4rpx;
}

.package-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #c8161d;
}

.package-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  vertical-align: top;
}

.page-footer {
  margin-top: 48rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.footer-deco {
  width: 246rpx;
  height: 22rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #9e9e9e;
  letter-spacing: 0.08em;
}

.scroll-bottom-space {
  height: calc(200rpx + env(safe-area-inset-bottom));
}

.fab-cart {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 1000;
}

/* 与商城页第二种购物车胶囊一致 */
.fab-inner {
  min-width: 0;
  width: auto;
  height: 88rpx;
  padding: 0 36rpx 0 28rpx;
  background: #d32029;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(211, 32, 41, 0.35);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.fab-icon {
  width: 40rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.fab-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.2;
  white-space: nowrap;
  flex-shrink: 0;
}
