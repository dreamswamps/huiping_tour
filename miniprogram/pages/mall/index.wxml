<view class="page">
  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero">
      <view class="hero-inner">
        <text class="hero-title">传薪茶社</text>
        <text class="hero-sub">品传薪茶，续红色魂</text>
        <view class="hero-deco">
          <image class="hero-flame" src="{{svgsUrl}}/svgs/svgs/mall-hero-spark.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="sheet">
      <view class="intro-card">
        <text class="intro-title">一茶载薪，文脉永续</text>
        <text class="intro-body">千里岗山脉，地处赣东北革命根据地腹地，是方志敏等革命先烈浴血奋战之地。传薪文创植根红色沃土，每一件文创藏品都承载军民鱼水情深的历史记忆，以物为媒，赓续红色血脉，让革命精神薪火代代相传。</text>
      </view>

      <view class="section-head">
        <view class="section-line" />
        <image class="section-flame" src="{{svgsUrl}}/svgs/svgs/mall-hero-spark.svg" mode="aspectFit" />
        <text class="section-title">产品系列</text>
        <image class="section-flame section-flame--flip" src="{{svgsUrl}}/svgs/svgs/mall-hero-spark.svg" mode="aspectFit" />
        <view class="section-line" />
      </view>

      <view wx:if="{{loadError}}" class="mall-err">
        <text>{{loadError}}</text>
      </view>

      <view wx:elif="{{loading}}" class="mall-loading">
        <text>商品加载中…</text>
      </view>

      <view wx:elif="{{products.length === 0}}" class="mall-empty">
        <text>暂无在售商品</text>
      </view>

      <view wx:else class="product-list">
        <view
          wx:for="{{products}}"
          wx:for-index="idx"
          wx:key="id"
          class="product-card {{idx < 3 ? 'product-card--hot' : ''}}"
          bindtap="onProductCardTap"
          data-id="{{item.id}}"
          data-price="{{item.price}}"
          data-thumb="{{item.thumb}}"
        >
          <image class="product-thumb" src="{{item.thumbUrl}}" mode="aspectFill" />
          <view class="product-body">
            <text class="product-name">{{item.name}}</text>
            <text class="product-desc">库存 {{item.stock}}</text>
            <view class="product-foot">
              <text class="product-price">¥{{item.priceDisplay}}</text>
              <view class="product-actions">
                <view class="btn-cart" catchtap="onAddCart" data-id="{{item.id}}">
                  <text>加入购物车</text>
                </view>
                <view class="btn-buy" catchtap="onBuyNow" data-id="{{item.id}}">
                  <text>立即购买</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="page-footer">
        <image class="footer-deco" src="{{svgsUrl}}/svgs/svgs/mall-footer-deco.svg" mode="widthFix" />
        <text class="footer-text">传薪茶社 · 品传薪茶，续红色魂</text>
      </view>

      <view class="scroll-bottom-space" />
    </view>
  </scroll-view>

  <view class="fab-cart" bindtap="onFabCart">
    <view class="fab-inner">
      <image class="fab-icon" src="{{svgsUrl}}/svgs/svgs/mall-fab-cart-icon.svg" mode="aspectFit" />
      <text class="fab-label">购物车</text>
    </view>
  </view>

  <mall-figma-tip id="mallFigmaTip" />
</view>
