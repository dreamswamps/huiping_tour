/* 页面容器 — Figma「改动-剩余」首页 2:112 */
.page {
  min-height: 100vh;
  background: #f8f5f0;
}

/* ========== 顶栏轮播（整页导出图顶部裁切） ========== */
.banner-section {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
  background: #111;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-slide {
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  background: #0a0a0a;
}

.banner-hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 指示条：中间红、两侧半透白 */
.custom-bars {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 10;
}

.bar {
  width: 56rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.5);
  transition: background 0.25s ease;
}

.bar-active {
  background: #c91f37;
}

.banner-overlay-ui {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 9;
}

.banner-overlay-ui .arrow-hit,
.banner-scan-wrap {
  pointer-events: auto;
}

.banner-scan-wrap {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 16rpx);
  right: 28rpx;
}

.banner-scan {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-scan-icon {
  width: 44rpx;
  height: 44rpx;
}

.arrow-hit {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100rpx;
  height: 160rpx;
  z-index: 2;
}

.arrow-hit-left {
  left: 0;
}

.arrow-hit-right {
  right: 0;
}

/* ========== 内容区（卡片压住轮播底） ========== */
.content-area {
  margin-top: -56rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #f8f5f0;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

.func-cards-wrap {
  margin-bottom: 32rpx;
}

.func-cards {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.func-card {
  width: 200rpx;
  height: 176rpx;
  background: #ffffff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.card-img {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.card-text {
  font-size: 24rpx;
  color: #5c3a21;
  font-weight: 500;
}

/* 语音导览整行 */
.voice-guide {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 22rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.voice-play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #c91f37;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voice-tri {
  color: #ffffff;
  font-size: 26rpx;
  margin-left: 4rpx;
  line-height: 1;
}

.voice-mic {
  width: 40rpx;
  height: 48rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.voice-text {
  font-size: 34rpx;
  color: #c91f37;
  font-weight: 700;
  margin-left: 16rpx;
}

/* ========== 热门景点 ========== */
.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-right: 4rpx;
}

.section-header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.title-bar {
  width: 6rpx;
  height: 36rpx;
  background: #a80101;
  margin-right: 12rpx;
  border-radius: 3rpx;
}

.section-title {
  font-size: 36rpx;
  color: #a80101;
  font-weight: 700;
}

.section-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.section-more-text {
  font-size: 22rpx;
  color: #b0a090;
  font-weight: 500;
}

.section-more-arrow {
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
  opacity: 0.75;
}

.spot-scroll {
  height: 680rpx;
  margin-bottom: 20rpx;
}

.spot-list {
  display: flex;
  flex-direction: column;
}

.spot-item {
  position: relative;
  width: 100%;
  min-height: 182rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.spot-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.spot-overlay {
  position: relative;
  z-index: 1;
  padding: 22rpx 26rpx 24rpx;
  min-height: 182rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: linear-gradient(
    180deg,
    rgba(40, 24, 12, 0.1) 0%,
    rgba(40, 24, 12, 0.55) 100%
  );
}

.spot-name {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1.35;
}

.spot-desc {
  font-size: 22rpx;
  color: rgba(255, 245, 235, 0.92);
  margin-top: 8rpx;
  line-height: 1.4;
}

.safe-bottom {
  height: 180rpx;
}
