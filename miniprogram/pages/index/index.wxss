/* 页面容器 */
.page {
  min-height: 100vh;
  background: #F8F5F0;
}

/* ========== 轮播图区域 ========== */
.banner-section {
  position: relative;
  width: 100%;
  height: 480rpx;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ========== 自定义轮播指示器 ========== */
.custom-dots {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 10;
}

/* 圆点（未选中） */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,0.5);
  transition: all 0.3s ease;
}

/* 选中态 - 拉成条形 */
.dot-active {
  width: 48rpx;   /* 拉长 */
  border-radius: 8rpx;
  background: #ffffff;
}

/* 右上角头像 */
.user-avatar {
  position: absolute;
  top: 40rpx;
  right: 30rpx;
  width: 64rpx;
  height: 64rpx;
  z-index: 10;
}

/* 左右箭头 */
.arrow-left,
.arrow-right {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}

.arrow-left {
  left: 20rpx;
}

.arrow-right {
  right: 20rpx;
}

.arrow-icon {
  width: 52rpx;
  height: 52rpx;
}

/* ========== 内容区域 ========== */
.content-area {
  margin-top: -60rpx;
  border-radius: 48rpx 48rpx 0 0;
  background: #F8F5F0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* ========== 功能卡片 ========== */
.func-cards {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  margin-bottom: 28rpx;
}

.func-card {
  width: 200rpx;
  height: 176rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-img {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.card-text {
  font-size: 24rpx;
  color: #5C3A21;
  font-weight: 400;
}

/* ========== AI导览卡片 ========== */
.ai-guide {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 红色圆圈 + 白色三角符号 */
.ai-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #A80101;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-triangle {
  color: #ffffff;
  font-size: 28rpx;
  margin-left: 4rpx;
  line-height: 1;
}

/* 右侧内容区 */
.ai-right {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.star {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.ai-text {
  font-size: 34rpx;
  color: #C91F37;
  font-weight: 700;
  margin-left: 16rpx;
}

/* ========== 热门景点 ========== */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-deco {
  width: 200rpx;
  height: 56rpx;
}

.title-bar {
  width: 6rpx;
  height: 36rpx;
  background: #A80101;
  margin-left: 16rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
}

.section-title {
  font-size: 36rpx;
  color: #A80101;
  font-weight: 700;
}

.spot-list {
  display: flex;
  flex-direction: column;
}

.spot-item {
  position: relative;
  width: 100%;
  height: 182rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.spot-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.spot-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 26rpx;
  background: linear-gradient(transparent, rgba(92,58,33,0.25));
}

.spot-name {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1.3;
}

.spot-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,235,220,0.88);
  margin-top: 6rpx;
  line-height: 1.3;
}

/* 查看更多 */
.more-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 0;
}

.more-text {
  font-size: 26rpx;
  color: #C9B7AB;
  font-weight: 600;
}

.more-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

/* 底部安全距离(原生tabBar) */
.safe-bottom {
  height: 180rpx;
}

/* ========== 其他Tab页面内容 ========== */
.page-content {
  height: calc(100vh - 110rpx);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.tab-page-header {
  margin-bottom: 60rpx;
}

.tab-page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #A80101;
  margin-bottom: 12rpx;
}

.tab-page-desc {
  display: block;
  font-size: 28rpx;
  color: #B8ABA0;
}

/* 占位区域 */
.map-placeholder,
.mall-placeholder,
.profile-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.map-placeholder image,
.mall-placeholder image,
.profile-placeholder image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.map-placeholder text,
.mall-placeholder text,
.profile-placeholder text {
  font-size: 28rpx;
  color: #B8ABA0;
}

/* ========== 自定义TabBar ========== */
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #FEF6F1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #EDE4DC;
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 4rpx;
}

/* 未选中态 - 强制统一灰色 #B8ABA0 */
.tab-item:not(.active) .tab-icon {
  filter: brightness(0) saturate(100%) invert(84%) sepia(6%) saturate(416%) hue-rotate(3deg) brightness(92%) contrast(88%);
}

/* 选中态 - 鲜红色 #A80101 */
.tab-item.active .tab-icon {
  filter: brightness(0) saturate(100%) invert(27%) sepia(95%) saturate(6000%) hue-rotate(355deg) brightness(85%) contrast(112%);
}

.tab-text {
  font-size: 22rpx;
  color: #B8ABA0;
  font-weight: 600;
}

.tab-text.active {
  color: #A80101;
}
