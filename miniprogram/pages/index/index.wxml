<!-- 首页 · Figma 改动-剩余 node 2:112 -->
<view class="page">
  <view class="banner-section">
    <swiper
      class="banner-swiper"
      autoplay="{{true}}"
      interval="{{4000}}"
      duration="{{500}}"
      circular="{{true}}"
      current="{{swiperCurrent}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{bannerList}}" wx:key="id">
        <view class="banner-slide">
          <image class="banner-hero-img" src="{{item.img}}" mode="aspectFill" />
        </view>
      </swiper-item>
    </swiper>

    <view class="banner-overlay-ui">
      <!-- 底图已含箭头时勿再叠 SVG，否则会重影；仅保留透明热区便于点击切页 -->
      <view class="arrow-hit arrow-hit-left" catchtap="onPrevSlide" />
      <view class="arrow-hit arrow-hit-right" catchtap="onNextSlide" />
      <view class="banner-scan-wrap">
        <view class="banner-scan" catchtap="onScanTap">
          <image class="banner-scan-icon" src="{{baseUrl}}/img/home-icon-scan.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="custom-bars">
      <view
        wx:for="{{bannerList}}"
        wx:key="id"
        class="bar {{swiperCurrent === index ? 'bar-active' : ''}}"
      />
    </view>
  </view>

  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="func-cards-wrap">
      <view class="func-cards">
        <view class="func-card" catchtap="goMap">
          <image class="card-img" src="{{baseUrl}}/img/card-map.svg" mode="aspectFit" />
          <text class="card-text">传薪地图</text>
        </view>
        <view class="func-card" catchtap="goToSubmodule" data-url="/pages/cloudar/cloudar">
          <image class="card-img" src="{{baseUrl}}/img/card-ar.svg" mode="aspectFit" />
          <text class="card-text">AR扫描</text>
        </view>
        <view class="func-card" catchtap="onFuncCard" data-type="badge">
          <image class="card-img" src="{{baseUrl}}/img/card-badge.svg" mode="aspectFit" />
          <text class="card-text">我的徽章</text>
        </view>
      </view>

      <view class="voice-guide" catchtap="onVoiceGuide">
        <view class="voice-play">
          <text class="voice-tri">▶</text>
        </view>
        <image class="voice-mic" src="{{baseUrl}}/img/home-icon-mic.svg" mode="aspectFit" />
        <text class="voice-text">语音导览</text>
      </view>
    </view>

    <view class="section-header">
      <view class="section-header-left">
        <view class="title-bar"></view>
        <text class="section-title">热门景点</text>
      </view>
      <view class="section-more">
        <text class="section-more-text">下滑查看更多</text>
        <image class="section-more-arrow" src="{{baseUrl}}/img/arrow-down.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="spot-list">
      <view class="spot-item" wx:for="{{spots}}" wx:key="title" catchtap="onSpotDetail" data-title="{{item.title}}">
        <image class="spot-bg" src="{{baseUrl}}/img/{{item.img}}" mode="aspectFill" />
        <view class="spot-overlay">
          <text class="spot-name">{{item.title}}</text>
          <text class="spot-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>
</view>
