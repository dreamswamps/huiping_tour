<!-- 首页 -->
<view class="page">

  <!-- 轮播图区域 -->
  <view class="banner-section">
    <swiper 
      class="banner-swiper" 
      autoplay="{{true}}" 
      interval="{{3000}}" 
      duration="{{500}}"
      circular="{{true}}"
      current="{{swiperCurrent}}"
      bindchange="onSwiperChange"
      id="mySwiper"
    >
      <swiper-item wx:for="{{5}}" wx:key="index">
        <image class="banner-img" src="{{baseUrl}}/img/banner-main.svg" mode="aspectFill"></image>
      </swiper-item>
    </swiper>

    <!-- 自定义指示器：5个点，选中拉成条 -->
    <view class="custom-dots">
      <view 
        wx:for="{{5}}" 
        wx:key="index"
        class="dot {{swiperCurrent === index ? 'dot-active' : ''}}"
        style="--dot-index: {{index}};"
      ></view>
    </view>
    
    <!-- 左侧箭头 -->
    <view class="arrow-left" catchtap="onPrevSlide">
      <image class="arrow-icon" src="{{baseUrl}}/img/arrow-left.svg"></image>
    </view>

    <!-- 右侧箭头 -->
    <view class="arrow-right" catchtap="onNextSlide">
      <image class="arrow-icon" src="{{baseUrl}}/img/arrow-right.svg"></image>
    </view>

    <!-- 右上角用户头像 -->
    <image class="user-avatar" src="{{baseUrl}}/img/avatar-default.svg" catchtap="onUserTap"></image>
  </view>

  <!-- 内容区域 -->
  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">
    
    <!-- 功能入口卡片 -->
    <view class="func-cards">
      <view class="func-card" catchtap="goMap">
        <image class="card-img" src="{{baseUrl}}/img/card-map.svg" mode="aspectFit"></image>
        <text class="card-text">传薪地图</text>
      </view>
      <view class="func-card" catchtap="goToSubmodule" data-url="/pages/cloudar/cloudar">
        <image class="card-img" src="{{baseUrl}}/img/card-ar.svg" mode="aspectFit"></image>
        <text class="card-text">AR扫描</text>
      </view>
      <view class="func-card" catchtap="onFuncCard">
        <image class="card-img" src="{{baseUrl}}/img/card-badge.svg" mode="aspectFit"></image>
        <text class="card-text">任务徽章</text>
      </view>
    </view>

    <!-- AI导览卡片 -->
    <view class="ai-guide" catchtap="onAIGuide">
      <view class="ai-circle">
        <text class="ai-triangle">▶</text>
      </view>
      <view class="ai-right">
        <image class="star" src="{{baseUrl}}/img/star-1.svg" mode="aspectFit"></image>
        <image class="star" src="{{baseUrl}}/img/star-2.svg" mode="aspectFit"></image>
        <text class="ai-text">AI导览</text>
      </view>
    </view>

    <!-- 热门景点 -->
    <view class="section-header">
      <view class="title-bar"></view>
      <text class="section-title">热门景点</text>
    </view>

    <!-- 景点列表 -->
    <view class="spot-list">
      <view class="spot-item" catchtap="onSpotDetail">
        <image class="spot-bg" src="{{baseUrl}}/img/spot-night-raid.svg" mode="aspectFill"></image>
        <view class="spot-overlay">
          <text class="spot-name">陈列馆·夜袭镇公所</text>
          <text class="spot-desc">1930年秋，红军夜袭镇公所，打响了革命第一枪</text>
        </view>
      </view>
      <view class="spot-item" catchtap="onSpotDetail">
        <image class="spot-bg" src="{{baseUrl}}/img/spot-red-army.svg" mode="aspectFill"></image>
        <view class="spot-overlay">
          <text class="spot-name">红军路·薪火相传</text>
          <text class="spot-desc">沿着先辈足迹，感受长征精神的伟大力量</text>
        </view>
      </view>
      <view class="spot-item" catchtap="onSpotDetail">
        <image class="spot-bg" src="{{baseUrl}}/img/spot-party-history.svg" mode="aspectFill"></image>
        <view class="spot-overlay">
          <text class="spot-name">党史馆·淬火成钢</text>
          <text class="spot-desc">百年党史，铭记奋斗历程与革命先烈</text>
        </view>
      </view>

      <!-- 查看更多提示 -->
      <view class="more-tip">
        <text class="more-text">下滑查看更多</text>
        <image class="more-arrow" src="{{baseUrl}}/img/arrow-down.svg" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 底部安全距离 -->
    <view class="safe-bottom"></view>
  </scroll-view>
</view>
