<!-- 个人中心 -->
<view class="page">

  <!-- ========== 顶部渐变区 ========== -->
  <view class="header-area">

    <!-- 标题 -->
    <text class="page-title">个人中心</text>

    <!-- 未登录：不展示头像与昵称，仅提示语 -->
    <view class="guest-header" wx:if="{{!isLogin}}">
      <!-- <text class="login-tip">登录后体验更多功能</text> -->
    </view>

    <!-- 已登录：展示头像、昵称、UID -->
    <view class="user-info" wx:if="{{isLogin}}">
      <view class="avatar-box">
        <image class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" wx:if="{{userInfo.avatar}}"></image>
        <text class="avatar-emoji" wx:else>🙍</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickname || '微信用户'}}</text>
        <text class="user-uid">UID: {{userInfo.uid || '---'}}</text>
      </view>
    </view>

    <!-- 登录按钮区域 -->
    <view class="login-btn-area" wx:if="{{!isLogin}}">
      <button
        class="wx-login-btn"
        hover-class="wx-login-btn-hover"
        hover-stay-time="120"
        bindtap="onLogin"
      >
        <text class="wx-icon">💬</text>
        <text class="wx-login-text">微信一键登录</text>
      </button>
      <text class="login-hint">登录即表示同意《用户协议》和《隐私政策》</text>
    </view>

  </view>

  <!-- ========== 功能卡片（3 宫格） ========== -->
  <view class="func-card">
    <block wx:for="{{funcList}}" wx:key="id">
      <view
        class="func-item"
        hover-class="func-item--active"
        hover-stay-time="100"
        catchtap="onFuncTap"
        data-id="{{item.id}}"
      >
        <view class="func-icon-wrap">
          <text class="func-icon">{{item.icon}}</text>
        </view>
        <text class="func-label">{{item.label}}</text>
      </view>
    </block>
  </view>

  <!-- ========== 内容列表（浅色背景区） ========== -->
  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">

    <block wx:for="{{menuList}}" wx:key="id">
      <view class="menu-item" catchtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-icon-wrap">
          <image class="menu-icon-bg" src="{{baseUrl}}/img/{{item.iconBg}}.svg" mode="aspectFit"></image>
          <image class="menu-icon-fg" src="{{baseUrl}}/img/{{item.iconFg}}.svg" mode="aspectFit"></image>
        </view>
        <text class="menu-label">{{item.label}}</text>
        <text class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        <image class="menu-arrow" src="{{baseUrl}}/img/profile-arrow.svg" mode="aspectFit"></image>
      </view>
    </block>

    <view class="safe-bottom"></view>

    <!-- 退出登录按钮 -->
    <view class="logout-btn-wrapper" wx:if="{{isLogin}}">
      <button class="logout-btn" bindtap="onLogout" plain="true">退出登录</button>
    </view>

  </scroll-view>

</view>
