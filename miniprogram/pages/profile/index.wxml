<!-- 个人中心 -->
<view class="page">

  <!-- ========== 顶部渐变区 ========== -->
  <view class="header-area">

    <!-- 标题 -->
    <text class="page-title">个人中心</text>

    <!-- 用户信息 -->
    <view class="user-info">
      <view class="avatar-box">
        <image class="avatar-img" src="{{baseUrl}}/img/profile-avatar.svg" mode="aspectFill" wx:if="{{false}}"></image>
        <text class="avatar-emoji">🙍</text>
      </view>
      <view class="user-detail">
        <text class="user-name">传薪旅行者</text>
        <text class="user-uid">UID: CX20250115</text>
      </view>
    </view>

  </view>

  <!-- ========== 功能卡片（白色） ========== -->
  <view class="func-card">
    <block wx:for="{{funcList}}" wx:key="id">
      <view class="func-item" catchtap="onFuncTap" data-id="{{item.id}}">
        <text class="func-icon">{{item.icon}}</text>
        <text class="func-label">{{item.label}}</text>
      </view>
    </block>
  </view>

  <!-- ========== 内容列表（浅色背景区） ========== -->
  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">

    <block wx:for="{{menuList}}" wx:key="id">
      <view class="menu-item" catchtap="onMenuTap" data-id="{{item.id}}">
        <image class="menu-icon-bg" src="{{baseUrl}}/img/{{item.iconBg}}.svg" mode="aspectFit"></image>
        <image class="menu-icon-fg" src="{{baseUrl}}/img/{{item.iconFg}}.svg" mode="aspectFit"></image>
        <text class="menu-label">{{item.label}}</text>
        <text class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        <image class="menu-arrow" src="{{baseUrl}}/img/profile-arrow.svg" mode="aspectFit"></image>
      </view>
    </block>

    <view class="safe-bottom-lg"></view>
  </scroll-view>

</view>
