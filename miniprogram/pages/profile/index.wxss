/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #F8F5F0;
}

/* ==================== 顶部渐变区 ==================== */
.header-area {
  background: linear-gradient(141deg, #B83749 0%, #C41933 24%, #1F0005 73%);
  padding: 20rpx 26rpx 0;
}

/* 页面标题 */
.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #FFFFFF;
  font-family: 'Noto Sans SC', sans-serif;
}

/* 用户信息行 */
.user-info {
  display: flex;
  align-items: center;
  padding: 16rpx 0 36rpx;
}

/* 头像 */
.avatar-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F6E4C8;
  border: 4rpx solid #E6C288;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-emoji {
  font-size: 60rpx;
}

/* 用户名 + UID */
.user-detail {
  margin-left: 24rpx;
}
.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.user-uid {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
}

/* ==================== 功能卡片（白色） ==================== */
.func-card {
  margin: -30rpx 26rpx 0;
  padding: 28rpx 14rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  display: flex;
  justify-content: space-between;
}

/* 单个功能入口 */
.func-item {
  width: 156rpx;
  height: 176rpx;
  background: #F9F7F3;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.func-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}
.func-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #212121;
}

/* ==================== 内容列表区（浅色背景） ==================== */
.content-area {
  height: calc(100vh - 520rpx);
  padding: 24rpx 26rpx 0;
}

/* 菜单项 */
.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 110rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #E3E3E3;
  box-sizing: border-box;
  padding: 0 26rpx;
  margin-bottom: 18rpx;
}

/* 左侧图标（背景圆 + 前景图叠加） */
.menu-icon-bg {
  width: 54rpx;
  height: 56rpx;
  position: relative;
  z-index: 1;
}
.menu-icon-fg {
  width: 38rpx;
  height: 38rpx;
  position: absolute;
  left: 38rpx;
  z-index: 2;
}

/* 文字标签 */
.menu-label {
  font-size: 28rpx;
  color: #212121;
  margin-left: 22rpx;
  flex: 1;
}

/* 未读徽标 */
.menu-badge {
  font-size: 24rpx;
  color: #FFFFFF;
  background: #C91F37;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

/* 右侧箭头 */
.menu-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* ==================== 底部安全距离 ==================== */
.safe-bottom-lg {
  height: 140rpx;
}
