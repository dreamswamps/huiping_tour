/* ==================== 页面容器 ==================== */
.page {
  min-height: 100vh;
  background: #F8F5F0;
}

/* ==================== 顶部渐变区 ==================== */
.header-area {
  background: linear-gradient(141deg, #B83749 0%, #C41933 24%, #1F0005 73%);
  padding: 20rpx 26rpx 0;
}

/* 页面标题 */
.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #FFFFFF;
  font-family: 'Noto Sans SC', sans-serif;
}

/* 未登录：顶部提示（无头像） */
.guest-header {
  padding: 24rpx 0 20rpx;
}
.guest-header .login-tip {
  display: block;
}

/* 用户信息行（仅登录后） */
.user-info {
  display: flex;
  align-items: center;
  padding: 16rpx 0 36rpx;
}

/* 头像 */
.avatar-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F6E4C8;
  border: 4rpx solid #E6C288;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-emoji {
  font-size: 60rpx;
}

/* 用户名 + UID */
.user-detail {
  margin-left: 24rpx;
}
.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.user-uid {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
}
.login-tip {
  font-size: 28rpx;
  font-weight: 400;
  opacity: 0.9;
}

/* 登录按钮区域 */
.login-btn-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 26rpx 36rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  padding: 0;
  margin: 0;
  border-radius: 46rpx;
  border: 2rpx solid rgba(230, 194, 136, 0.65);
  background: linear-gradient(180deg, #FFF9F0 0%, #F0DFC4 55%, #E6C288 100%);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.22), inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn-hover {
  opacity: 0.92;
  transform: scale(0.985);
}

.wx-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.wx-login-text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #4A0D14;
}

.login-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 16rpx;
}

/* 退出登录按钮区域 */
.logout-btn-area {
  margin-left: auto;
}

.logout-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
  line-height: 1.5;
}

.logout-btn::after {
  border: none;
}

/* ==================== 功能卡片（3 宫格） ==================== */
.func-card {
  position: relative;
  z-index: 1;
  margin: -30rpx 26rpx 0;
  padding: 24rpx 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 0, 5, 0.14);
  border: 2rpx solid rgba(230, 194, 136, 0.35);
  box-sizing: border-box;
}

/* 单个功能入口 */
.func-item {
  flex: 1;
  min-width: 0;
  padding: 26rpx 10rpx 22rpx;
  background: linear-gradient(180deg, #FFFCF8 0%, #F3EDE4 100%);
  border-radius: 32rpx;
  border: 2rpx solid rgba(230, 194, 136, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.75);
  box-sizing: border-box;
}

.func-item--active {
  opacity: 0.9;
  transform: scale(0.97);
}

.func-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #FFFFFF 0%, #EFE4D4 100%);
  border: 2rpx solid rgba(201, 25, 51, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 20rpx rgba(74, 13, 20, 0.08);
}

.func-icon {
  font-size: 44rpx;
  line-height: 1;
}

.func-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #3d2e26;
  text-align: center;
  line-height: 1.35;
  padding: 0 4rpx;
}

/* ==================== 内容列表区（浅色背景） ==================== */
.content-area {
  height: calc(100vh - 520rpx);
  padding: 24rpx 26rpx 0;
}

/* 菜单项 */
.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 110rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #E3E3E3;
  box-sizing: border-box;
  padding: 0 26rpx;
  margin-bottom: 18rpx;
}

/* 左侧图标（背景圆 + 前景图叠加） */
.menu-icon-wrap {
  position: relative;
  width: 54rpx;
  height: 56rpx;
  flex-shrink: 0;
}
.menu-icon-bg {
  width: 54rpx;
  height: 56rpx;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
}
.menu-icon-fg {
  width: 38rpx;
  height: 38rpx;
  position: absolute;
  left: 8rpx;
  top: 9rpx;
  z-index: 2;
}

/* 文字标签 */
.menu-label {
  font-size: 28rpx;
  color: #212121;
  margin-left: 22rpx;
  flex: 1;
}

/* 未读徽标 */
.menu-badge {
  font-size: 24rpx;
  color: #FFFFFF;
  background: #C91F37;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

/* 右侧箭头 */
.menu-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* ==================== 退出登录按钮 ==================== */
.safe-bottom {
  height: 40rpx;
}

.logout-btn-wrapper {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 40rpx;
}

.logout-btn {
  width: 400rpx;
  height: 80rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 60rpx;
}

.logout-btn::after {
  border: none;
}
