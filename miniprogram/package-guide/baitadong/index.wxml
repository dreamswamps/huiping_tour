<view class="page">
  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero-wrap">
      <image
        class="hero"
        src="https://free.picui.cn/free/2026/05/16/6a086d2564bd3.png"
        mode="aspectFill"
      />
      <view class="hero-safe" />
      <image
        class="btn-back"
        src="{{svgsUrl}}/svgs/svgs/baitadong-back.svg"
        mode="aspectFit"
        bindtap="onBack"
      />
    </view>

    <view class="panel">
      <view class="content">
        <text class="name">白塔洞</text>
        <text class="tagline">洞崖滴水，常年不绝</text>
        <view class="divider" />
        <text class="body">{{body}}</text>
      </view>
    </view>

    <view class="bottom-pad" />
  </scroll-view>

  <mall-bottom-tab selected="{{0}}" />
</view>
