<view class="page">
  <view class="vg-top">
    <view class="nav-bar">
      <view class="back-btn" catchtap="onBack">
        <image class="back-icon" src="https://svgs1.oss-cn-beijing.aliyuncs.com/svgs/svgs/benefits-back-arrow.svg" mode="aspectFit"></image>
        <text class="back-text">返回</text>
      </view>
      <text class="nav-title">语音导览</text>
    </view>
  </view>

  <scroll-view class="vg-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="vg-hero-wrap">
      <!-- <image
        class="vg-hero"
        src="{{svgsUrl}}/svgs/svgs/voice-guide-hero.png"
        mode="aspectFill"
      /> -->
        <image
        class="vg-hero"
        src="https://svgs1.oss-cn-beijing.aliyuncs.com/voice-guide-hero.png"
        mode="aspectFill"
      />
    </view>

    <view class="vg-panel">
      <view
        class="vg-card"
        wx:for="{{tracks}}"
        wx:key="id"
      >
        <view class="vg-thumb">
          <image class="vg-thumb-img" src="{{item.imgUrl}}" mode="aspectFill"></image>
        </view>
        <view class="vg-main">
          <text class="vg-name">{{item.name}}</text>
          <text class="vg-desc">{{item.desc}}</text>
        </view>
        <view class="vg-divider" />
        <view class="vg-side">
          <view
            class="vg-play {{playingId === item.id ? 'vg-play--on' : ''}}"
            bindtap="onPlayTap"
            data-id="{{item.id}}"
          >
            <text class="vg-play-tri">{{playingId === item.id && isPlaying ? '⏸' : '▶'}}</text>
          </view>
          <text class="vg-time">{{playingId === item.id ? trackTimes[item.id] : (trackDurations[item.id] || '0:00')}}</text>
        </view>
      </view>
    </view>

    <view class="vg-scroll-pad" />
  </scroll-view>

  <mall-bottom-tab selected="{{0}}" />
</view>
